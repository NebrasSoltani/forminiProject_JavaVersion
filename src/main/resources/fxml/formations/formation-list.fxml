<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.formini.controllers.formations.FormationListController"
            style="-fx-background-color: #1e293b;">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT"
              style="-fx-padding: 20 30; -fx-background-color: #0f172a; -fx-border-color: #334155; -fx-border-width: 0 0 1 0;">
            <children>
                <TextField fx:id="searchField" promptText="Rechercher une formation..."
                           onKeyReleased="#handleSearch" HBox.hgrow="ALWAYS"
                           style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-prompt-text-fill: #475569; -fx-border-color: #334155; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;"/>
                <Button text="Actualiser" onAction="#handleRefresh"
                        style="-fx-background-color: #334155; -fx-text-fill: #94a3b8; -fx-background-radius: 8; -fx-padding: 10 16; -fx-cursor: hand;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="resultCountLabel" text="0 formation(s)"
                       style="-fx-font-weight: bold; -fx-text-fill: #38bdf8; -fx-font-size: 13px;"/>
            </children>
            <padding><Insets top="4" bottom="4"/></padding>
        </HBox>
    </top>

    <center>
        <ScrollPane fx:id="catalogScroll" fitToWidth="true"
                    style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
            <content>
                <TilePane fx:id="formationsGrid" prefTileWidth="270" prefColumns="3"
                          hgap="18" vgap="18"
                          style="-fx-padding: 24; -fx-background-color: #1e293b;"/>
            </content>
        </ScrollPane>
    </center>
</BorderPane>