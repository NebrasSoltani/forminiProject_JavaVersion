<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #0f172a; -fx-border-color: transparent;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="tn.formini.controllers.formations.MyInscriptionsController">
    <VBox spacing="25" style="-fx-padding: 30; -fx-background-color: #0f172a;">
        <children>
            <HBox alignment="CENTER_LEFT" spacing="20">
                <children>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Mes Inscriptions" style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                        <Label fx:id="resultCountLabel" text="Chargement de vos formations..." style="-fx-font-size: 14px; -fx-text-fill: #94a3b8;"/>
                    </VBox>
                    <Button onAction="#handleRefresh" text="🔄 Actualiser" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 20; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </children>
            </HBox>

            <TilePane fx:id="formationsGrid" hgap="20" vgap="20" prefColumns="3" style="-fx-background-color: transparent;">
                <!-- Cards will be injected here -->
            </TilePane>

            <VBox fx:id="emptyState" alignment="CENTER" spacing="15" visible="false" managed="false" style="-fx-padding: 100 0;">
                <Label text="📭" style="-fx-font-size: 64px;"/>
                <Label text="Vous n'êtes inscrit à aucune formation pour le moment." style="-fx-font-size: 18px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                <Button text="Parcourir le catalogue" onAction="#goToCatalogue" style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 12 30; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </VBox>
        </children>
    </VBox>
</ScrollPane>
