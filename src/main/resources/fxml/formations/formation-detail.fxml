<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.formini.controllers.formations.FormationDetailController"
      spacing="16" style="-fx-background-color: #1e293b; -fx-padding: 30;">

    <children>
        <Label fx:id="titreLabel" text="Titre"
               style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: white;"/>

        <HBox spacing="20" alignment="TOP_LEFT"
              style="-fx-background-color: #0f172a; -fx-background-radius: 16; -fx-padding: 20; -fx-border-color: #334155; -fx-border-width: 1; -fx-border-radius: 16;">
            <children>
                <ImageView fx:id="coverImageView" fitWidth="300" fitHeight="180"
                           preserveRatio="false" smooth="true"
                           style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 12, 0, 0, 4);"/>
                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="categorieLabel" text="Catégorie:" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
                        <Label fx:id="niveauLabel" text="Niveau:" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
                        <Label fx:id="langueLabel" text="Langue:" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
                        <Label fx:id="dureeLabel" text="Durée:" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
                        <Label fx:id="prixLabel" text="Prix:" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
                        <Label fx:id="statutInscriptionLabel" text="Statut inscription"
                               style="-fx-font-weight: bold; -fx-text-fill: #38bdf8; -fx-font-size: 14px;"/>
                    </children>
                </VBox>
            </children>
        </HBox>

        <Label text="Description" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #e2e8f0;"/>
        <ScrollPane fitToWidth="true" prefHeight="200"
                    style="-fx-background-color: transparent; -fx-background: #0f172a; -fx-border-color: #334155; -fx-border-radius: 12; -fx-background-radius: 12;">
            <content>
                <Label fx:id="descriptionLabel" wrapText="true"
                       style="-fx-padding: 14; -fx-text-fill: #94a3b8; -fx-font-size: 13px; -fx-background-color: #0f172a;"/>
            </content>
        </ScrollPane>

        <HBox spacing="12" alignment="CENTER_RIGHT">
            <children>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="S'inscrire" fx:id="inscriptionButton" onAction="#handleInscription"
                        style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 22; -fx-cursor: hand;"/>
                <Button text="Commencer" fx:id="commencerButton" onAction="#handleCommencer"
                        style="-fx-background-color: #38bdf8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 22; -fx-cursor: hand;"/>
                <Button text="Fermer" onAction="#handleClose"
                        style="-fx-background-color: #334155; -fx-text-fill: #94a3b8; -fx-background-radius: 10; -fx-padding: 10 18; -fx-cursor: hand;"/>
            </children>
            <padding><Insets top="6"/></padding>
        </HBox>
    </children>
</VBox>