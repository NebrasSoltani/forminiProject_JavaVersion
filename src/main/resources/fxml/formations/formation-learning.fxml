<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.formini.controllers.formations.FormationLearningController"
            style="-fx-background-color: #1e293b;">

    <top>
        <VBox spacing="4" style="-fx-padding: 16 30; -fx-background-color: #0f172a; -fx-border-color: #334155; -fx-border-width: 0 0 1 0;">
            <children>
                <Label fx:id="formationTitleLabel" text="Formation"
                       style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                <Label fx:id="progressionLabel" text="Progression: 0%"
                       style="-fx-text-fill: #38bdf8; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            </children>
        </VBox>
    </top>

    <left>
        <VBox spacing="10" prefWidth="300"
              style="-fx-padding: 16; -fx-background-color: #0f172a; -fx-border-color: #334155; -fx-border-width: 0 1 0 0;">
            <children>
                <Label text="📚 Leçons"
                       style="-fx-font-size: 14px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                <ListView fx:id="lessonsListView" VBox.vgrow="ALWAYS"
                          style="-fx-background-color: #1e293b; -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8;"/>
                <Button fx:id="showRecommendationsButton" text="🎯 Voir Recommandations"
                        onAction="#handleShowRecommendations" maxWidth="Infinity"
                        style="-fx-padding: 10; -fx-font-size: 13px; -fx-background-color: #4f46e5; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </children>
        </VBox>
    </left>

    <center>
        <TabPane fx:id="learningTabPane" tabClosingPolicy="UNAVAILABLE"
                 style="-fx-background-color: #1e293b; -fx-padding: 10;">
            <tabs>
                <Tab text="📖 Leçon">
                    <VBox spacing="12" style="-fx-padding: 20; -fx-background-color: #1e293b;">
                        <children>
                            <Label fx:id="lessonTitleLabel" text="Sélectionnez une leçon"
                                   style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                            <Label fx:id="lessonDescriptionLabel" wrapText="true"
                                   style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
                            <Label fx:id="lessonDurationLabel"
                                   style="-fx-text-fill: #22c55e; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                            <Label fx:id="videoStatusLabel" text="🎥 Chargeur vidéo"
                                   style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                            <Button text="🌐 Ouvrir vidéo dans le navigateur"
                                    onAction="#handleOpenVideoInBrowser"
                                    style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-padding: 8 18; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;"/>
                            <VBox fx:id="videoContainer" VBox.vgrow="ALWAYS" minHeight="400"
                                  style="-fx-background-color: #0f172a; -fx-border-color: #334155; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10;"/>
                        </children>
                    </VBox>
                </Tab>

                <Tab text="📚 Livres Recommandés">
                    <HBox spacing="12" style="-fx-padding: 16; -fx-background-color: #1e293b;">
                        <children>
                            <VBox spacing="10" prefWidth="400">
                                <children>
                                    <Label text="Livres Recommandés"
                                           style="-fx-font-size: 14px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                                    <ListView fx:id="booksListView" VBox.vgrow="ALWAYS" prefHeight="380"
                                              style="-fx-background-color: #0f172a; -fx-border-color: #334155; -fx-border-radius: 8;"/>
                                    <Label fx:id="bookDetailsLabel" wrapText="true"
                                           style="-fx-text-fill: #94a3b8; -fx-padding: 10; -fx-background-color: #0f172a; -fx-background-radius: 8; -fx-border-color: #334155; -fx-border-width: 1; -fx-border-radius: 8;"/>
                                    <HBox spacing="10">
                                        <children>
                                            <Button text="📤 Publier comme leçon"
                                                    onAction="#handlePublishSelectedBookAsLesson"
                                                    style="-fx-padding: 8 14; -fx-background-color: #16a085; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"/>
                                            <Button text="🌐 Ouvrir" onAction="#handleOpenBookInBrowser"
                                                    style="-fx-padding: 8 14; -fx-background-color: #0284c7; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
                                            <Button text="🔄 Rafraîchir" onAction="#handleRefreshBooks"
                                                    style="-fx-padding: 8 14; -fx-background-color: #7c3aed; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>
                            <VBox spacing="8" VBox.vgrow="ALWAYS">
                                <children>
                                    <Label text="🔍 Aperçu"
                                           style="-fx-font-weight: 900; -fx-text-fill: white; -fx-font-size: 13px;"/>
                                    <WebView fx:id="previewWebView" VBox.vgrow="ALWAYS" prefHeight="460"/>
                                    <Label fx:id="previewStatusLabel" text="✅ Prêt"
                                           style="-fx-text-fill: #22c55e; -fx-font-size: 11px;"/>
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </Tab>

                <Tab text="🎥 Vidéos Recommandées">
                    <HBox spacing="12" style="-fx-padding: 16; -fx-background-color: #1e293b;">
                        <children>
                            <VBox spacing="10" prefWidth="400">
                                <children>
                                    <Label text="Vidéos Recommandées"
                                           style="-fx-font-size: 14px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                                    <ListView fx:id="videosListView" VBox.vgrow="ALWAYS" prefHeight="380"
                                              style="-fx-background-color: #0f172a; -fx-border-color: #334155; -fx-border-radius: 8;"/>
                                    <Label fx:id="videoDetailsLabel" wrapText="true"
                                           style="-fx-text-fill: #94a3b8; -fx-padding: 10; -fx-background-color: #0f172a; -fx-background-radius: 8; -fx-border-color: #334155; -fx-border-width: 1; -fx-border-radius: 8;"/>
                                    <HBox spacing="10">
                                        <children>
                                            <Button text="📤 Publier comme leçon"
                                                    onAction="#handlePublishSelectedVideoAsLesson"
                                                    style="-fx-padding: 8 14; -fx-background-color: #dc2626; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"/>
                                            <Button text="🌐 Ouvrir" onAction="#handleOpenVideoInBrowser"
                                                    style="-fx-padding: 8 14; -fx-background-color: #0284c7; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
                                            <Button text="🔄 Rafraîchir" onAction="#handleRefreshVideos"
                                                    style="-fx-padding: 8 14; -fx-background-color: #7c3aed; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>
                            <VBox spacing="8" VBox.vgrow="ALWAYS">
                                <children>
                                    <Label text="🔍 Aperçu"
                                           style="-fx-font-weight: 900; -fx-text-fill: white; -fx-font-size: 13px;"/>
                                    <WebView fx:id="videoPreviewWebView" VBox.vgrow="ALWAYS" prefHeight="460"/>
                                    <Label fx:id="videoPreviewStatusLabel" text="✅ Prêt"
                                           style="-fx-text-fill: #22c55e; -fx-font-size: 11px;"/>
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </Tab>

                <Tab text="💬 Assistant IA">
                    <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: #1e293b;">
                        <children>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <children>
                                    <Label text="Assistant Virtuel"
                                           style="-fx-font-size: 16px; -fx-font-weight: 900; -fx-text-fill: #a855f7;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="🗑️ Effacer" onAction="#handleClearChat"
                                            style="-fx-background-color: rgba(239,68,68,0.15); -fx-text-fill: #ef4444; -fx-padding: 6 12; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;"/>
                                </children>
                            </HBox>
                            <Label text="Posez vos questions sur les leçons, vidéos, livres et progression"
                                   style="-fx-text-fill: #475569; -fx-font-size: 11px;"/>
                            <ScrollPane fx:id="chatScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                                        style="-fx-background-color: #0f172a; -fx-border-color: #334155; -fx-border-radius: 12; -fx-background-radius: 12;">
                                <content>
                                    <VBox fx:id="chatMessagesContainer" spacing="8"
                                          style="-fx-padding: 12; -fx-background-color: #0f172a;"/>
                                </content>
                            </ScrollPane>
                            <HBox spacing="10">
                                <children>
                                    <TextField fx:id="chatInputField" promptText="Écrivez votre message..."
                                               HBox.hgrow="ALWAYS"
                                               style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-prompt-text-fill: #475569; -fx-border-color: #334155; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;"/>
                                    <Button text="Envoyer" onAction="#handleSendChatMessage"
                                            style="-fx-background-color: #a855f7; -fx-text-fill: white; -fx-padding: 10 18; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;"/>
                                </children>
                            </HBox>
                            <Label fx:id="chatStatusLabel" text="✅ Assistant prêt"
                                   style="-fx-text-fill: #22c55e; -fx-font-size: 11px;"/>
                        </children>
                    </VBox>
                </Tab>
            </tabs>
        </TabPane>
    </center>

    <bottom>
        <HBox spacing="12" alignment="CENTER_RIGHT"
              style="-fx-padding: 14 20; -fx-background-color: #0f172a; -fx-border-color: #334155; -fx-border-width: 1 0 0 0;">
            <children>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="completeLessonButton" text="✅ Marquer leçon terminée"
                        onAction="#handleMarkLessonDone"
                        style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-padding: 10 22; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button text="❌ Fermer" onAction="#handleClose"
                        style="-fx-background-color: #334155; -fx-text-fill: #94a3b8; -fx-padding: 10 20; -fx-background-radius: 10; -fx-cursor: hand;"/>
            </children>
            <padding><Insets top="0" bottom="0"/></padding>
        </HBox>
    </bottom>
</BorderPane>