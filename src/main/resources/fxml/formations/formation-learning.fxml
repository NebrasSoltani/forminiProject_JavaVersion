<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.formini.controllers.formations.FormationLearningController"
            style="-fx-background-color: #f5f6fa;">

    <top>
        <VBox spacing="4" style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #ecf0f1; -fx-border-width: 0 0 1 0;">
            <children>
                <Label fx:id="formationTitleLabel" text="Formation" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label fx:id="progressionLabel" text="Progression: 0%" style="-fx-text-fill: #3498db; -fx-font-size: 13px;"/>
            </children>
        </VBox>
    </top>

    <left>
        <VBox spacing="8" prefWidth="320" style="-fx-padding: 10;">
            <children>
                <Label text="📚 Leçons" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <ListView fx:id="lessonsListView" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #ecf0f1;"/>
                <Button fx:id="showRecommendationsButton" text="🎯 Voir Recommandations"
                        onAction="#handleShowRecommendations"
                        style="-fx-padding: 10; -fx-font-size: 13px; -fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 5;"/>
            </children>
        </VBox>
    </left>

    <center>
        <TabPane fx:id="learningTabPane" tabClosingPolicy="UNAVAILABLE" style="-fx-padding: 10;">
            <tabs>
                <!-- Lesson Tab -->
                <Tab text="📖 Leçon">
                    <VBox spacing="10" style="-fx-padding: 10;">
                        <children>
                            <Label fx:id="lessonTitleLabel" text="Sélectionnez une leçon" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                            <Label fx:id="lessonDescriptionLabel" wrapText="true" style="-fx-text-fill: #636e72; -fx-font-size: 13px;"/>
                            <Label fx:id="lessonDurationLabel" style="-fx-text-fill: #16a085; -fx-font-size: 12px;"/>
                            <Label fx:id="videoStatusLabel" text="🎥 Chargeur vidéo" style="-fx-text-fill: #636e72; -fx-font-size: 12px;"/>
                            <Button text="🌐 Ouvrir vidéo dans le navigateur" onAction="#handleOpenVideoInBrowser"
                                    style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-padding: 8 15; -fx-background-radius: 5;"/>
                            <VBox fx:id="videoContainer" VBox.vgrow="ALWAYS" minHeight="400" style="-fx-background-color: #111; -fx-border-color: #ddd; -fx-border-width: 1;"/>
                        </children>
                    </VBox>
                </Tab>

                <!-- Books Recommendations Tab -->
                <Tab text="📚 Livres Recommandés">
                    <HBox spacing="10" style="-fx-padding: 10;">
                        <children>
                            <VBox spacing="8" prefWidth="420">
                                <children>
                                    <Label text="Livres Recommandés" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                    <ListView fx:id="booksListView" VBox.vgrow="ALWAYS" prefHeight="400" style="-fx-background-color: white; -fx-border-color: #ecf0f1;"/>
                                    <Label fx:id="bookDetailsLabel" wrapText="true" style="-fx-text-fill: #666; -fx-padding: 10; -fx-background-color: #f8f9fa; -fx-background-radius: 5;"/>
                                    <HBox spacing="10">
                                        <children>
                                            <Button text="📤 Publier comme leçon" onAction="#handlePublishSelectedBookAsLesson"
                                                    style="-fx-padding: 8; -fx-background-color: #16a085; -fx-text-fill: white; -fx-background-radius: 5;"/>
                                            <Button text="🌐 Ouvrir dans navigateur" onAction="#handleOpenBookInBrowser"
                                                    style="-fx-padding: 8; -fx-background-color: #2980b9; -fx-text-fill: white; -fx-background-radius: 5;"/>
                                            <Button text="🔄 Rafraîchir" onAction="#handleRefreshBooks"
                                                    style="-fx-padding: 8; -fx-background-color: #8e44ad; -fx-text-fill: white; -fx-background-radius: 5;"/>
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>
                            <VBox spacing="8" VBox.vgrow="ALWAYS" prefWidth="560">
                                <children>
                                    <Label text="🔍 Aperçu" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                    <WebView fx:id="previewWebView" VBox.vgrow="ALWAYS" prefHeight="500"/>
                                    <Label fx:id="previewStatusLabel" text="✅ Prêt" style="-fx-text-fill: #27ae60; -fx-font-size: 11px;"/>
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </Tab>

                <!-- Videos Recommendations Tab -->
                <Tab text="🎥 Vidéos Recommandées">
                    <HBox spacing="10" style="-fx-padding: 10;">
                        <children>
                            <VBox spacing="8" prefWidth="420">
                                <children>
                                    <Label text="Vidéos Recommandées (YouTube/Vimeo)" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                    <ListView fx:id="videosListView" VBox.vgrow="ALWAYS" prefHeight="400" style="-fx-background-color: white; -fx-border-color: #ecf0f1;"/>
                                    <Label fx:id="videoDetailsLabel" wrapText="true" style="-fx-text-fill: #666; -fx-padding: 10; -fx-background-color: #f8f9fa; -fx-background-radius: 5;"/>
                                    <HBox spacing="10">
                                        <children>
                                            <Button text="📤 Publier comme leçon" onAction="#handlePublishSelectedVideoAsLesson"
                                                    style="-fx-padding: 8; -fx-background-color: #c0392b; -fx-text-fill: white; -fx-background-radius: 5;"/>
                                            <Button text="🌐 Ouvrir dans navigateur" onAction="#handleOpenVideoInBrowser"
                                                    style="-fx-padding: 8; -fx-background-color: #2980b9; -fx-text-fill: white; -fx-background-radius: 5;"/>
                                            <Button text="🔄 Rafraîchir" onAction="#handleRefreshVideos"
                                                    style="-fx-padding: 8; -fx-background-color: #8e44ad; -fx-text-fill: white; -fx-background-radius: 5;"/>
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>
                            <VBox spacing="8" VBox.vgrow="ALWAYS" prefWidth="560">
                                <children>
                                    <Label text="🔍 Aperçu" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                    <WebView fx:id="videoPreviewWebView" VBox.vgrow="ALWAYS" prefHeight="500"/>
                                    <Label fx:id="videoPreviewStatusLabel" text="✅ Prêt" style="-fx-text-fill: #27ae60; -fx-font-size: 11px;"/>
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </Tab>

                <!-- Chatbot Tab -->
                <Tab text="💬 Assistant IA">
                    <VBox spacing="10" style="-fx-padding: 10;">
                        <children>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <children>
                                    <Label text="Assistant Virtuel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #9b59b6;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="🗑️ Effacer le chat" onAction="#handleClearChat"
                                            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 5 10; -fx-background-radius: 5;"/>
                                </children>
                            </HBox>
                            <Label text="Posez vos questions sur les leçons, vidéos, livres et progression"
                                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
                            <ScrollPane fx:id="chatScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                                        style="-fx-background-color: #f8f9fa; -fx-border-color: #ecf0f1;">
                                <content>
                                    <VBox fx:id="chatMessagesContainer" spacing="8"
                                          style="-fx-padding: 10; -fx-background-color: #f8f9fa;"/>
                                </content>
                            </ScrollPane>
                            <HBox spacing="10">
                                <children>
                                    <TextField fx:id="chatInputField" promptText="Écrivez votre message..."
                                               HBox.hgrow="ALWAYS" style="-fx-padding: 8; -fx-background-radius: 5;"/>
                                    <Button text="Envoyer" onAction="#handleSendChatMessage"
                                            style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-padding: 8 15; -fx-background-radius: 5;"/>
                                </children>
                            </HBox>
                            <Label fx:id="chatStatusLabel" text="✅ Assistant prêt"
                                   style="-fx-text-fill: #27ae60; -fx-font-size: 11px;"/>
                        </children>
                    </VBox>
                </Tab>
            </tabs>
        </TabPane>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #ecf0f1; -fx-border-width: 1 0 0 0;">
            <children>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="completeLessonButton" text="✅ Marquer leçon terminée" onAction="#handleMarkLessonDone"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 5; -fx-font-weight: bold;"/>
                <Button text="❌ Fermer" onAction="#handleClose"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 5;"/>
            </children>
            <padding>
                <Insets top="6" bottom="6"/>
            </padding>
        </HBox>
    </bottom>
</BorderPane>