<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.formini.controllers.formations.FormationRecommendationsController"
            style="-fx-background-color: #1e293b;">

    <top>
        <VBox spacing="4" style="-fx-padding: 16 30; -fx-background-color: #0f172a; -fx-border-color: #334155; -fx-border-width: 0 0 1 0;">
            <children>
                <Label fx:id="titleLabel" text="Recommandations"
                       style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: white;"/>
            </children>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="recommendationsTabPane" tabClosingPolicy="UNAVAILABLE"
                 style="-fx-background-color: #1e293b; -fx-padding: 10;">
            <tabs>
                <Tab text="📚 Livres Google Books">
                    <HBox spacing="12" style="-fx-padding: 16; -fx-background-color: #1e293b;">
                        <children>
                            <VBox spacing="10" prefWidth="400">
                                <children>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <children>
                                            <Label text="Livres:" style="-fx-font-weight: 900; -fx-text-fill: white;"/>
                                            <Button text="🔄 Actualiser" onAction="#handleRefreshBooks"
                                                    style="-fx-padding: 8 14; -fx-background-color: #7c3aed; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8; -fx-font-weight: bold;"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Label fx:id="booksCountLabel" text="0 livres"
                                                   style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                                        </children>
                                    </HBox>
                                    <ListView fx:id="booksListView" VBox.vgrow="ALWAYS"
                                              style="-fx-background-color: #0f172a; -fx-border-color: #334155; -fx-border-radius: 8; -fx-font-size: 12px;"/>
                                    <VBox spacing="5" style="-fx-padding: 10; -fx-border-color: #334155; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-color: #0f172a; -fx-background-radius: 8;">
                                        <children>
                                            <Label fx:id="bookDetailsLabel" wrapText="true"
                                                   style="-fx-text-fill: #e2e8f0; -fx-font-size: 12px;"/>
                                            <Label fx:id="bookAuthorLabel" wrapText="true"
                                                   style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
                                        </children>
                                    </VBox>
                                    <HBox spacing="10">
                                        <children>
                                            <Button text="✓ Publier comme leçon" onAction="#handlePublishBook"
                                                    style="-fx-padding: 8 14; -fx-background-color: #16a085; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8;"/>
                                            <Button text="🌐 Ouvrir" onAction="#handleOpenBook"
                                                    style="-fx-padding: 8 14; -fx-background-color: #0284c7; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;"/>
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>
                            <VBox spacing="8" VBox.vgrow="ALWAYS">
                                <children>
                                    <Label text="Aperçu du livre"
                                           style="-fx-font-weight: 900; -fx-font-size: 13px; -fx-text-fill: white;"/>
                                    <WebView fx:id="booksPreviewWebView" VBox.vgrow="ALWAYS" minHeight="400"/>
                                    <Label fx:id="booksPreviewStatusLabel"
                                           text="Sélectionnez un livre pour voir l'aperçu"
                                           style="-fx-text-fill: #22c55e; -fx-font-size: 11px;"/>
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </Tab>

                <Tab text="🎥 Vidéos YouTube">
                    <HBox spacing="12" style="-fx-padding: 16; -fx-background-color: #1e293b;">
                        <children>
                            <VBox spacing="10" prefWidth="400">
                                <children>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <children>
                                            <Label text="Vidéos:" style="-fx-font-weight: 900; -fx-text-fill: white;"/>
                                            <Button text="🔄 Actualiser" onAction="#handleRefreshVideos"
                                                    style="-fx-padding: 8 14; -fx-background-color: #7c3aed; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8; -fx-font-weight: bold;"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Label fx:id="videosCountLabel" text="0 vidéos"
                                                   style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                                        </children>
                                    </HBox>
                                    <ListView fx:id="videosListView" VBox.vgrow="ALWAYS"
                                              style="-fx-background-color: #0f172a; -fx-border-color: #334155; -fx-border-radius: 8; -fx-font-size: 12px;"/>
                                    <VBox spacing="5" style="-fx-padding: 10; -fx-border-color: #334155; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-color: #0f172a; -fx-background-radius: 8;">
                                        <children>
                                            <Label fx:id="videoDetailsLabel" wrapText="true"
                                                   style="-fx-text-fill: #e2e8f0; -fx-font-size: 12px;"/>
                                            <Label fx:id="videoChannelLabel" wrapText="true"
                                                   style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
                                        </children>
                                    </VBox>
                                    <HBox spacing="10">
                                        <children>
                                            <Button text="✓ Publier comme leçon" onAction="#handlePublishVideo"
                                                    style="-fx-padding: 8 14; -fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8;"/>
                                            <Button text="🌐 Ouvrir" onAction="#handleOpenVideo"
                                                    style="-fx-padding: 8 14; -fx-background-color: #0284c7; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;"/>
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>
                            <VBox spacing="8" VBox.vgrow="ALWAYS">
                                <children>
                                    <Label text="Aperçu vidéo"
                                           style="-fx-font-weight: 900; -fx-font-size: 13px; -fx-text-fill: white;"/>
                                    <WebView fx:id="videosPreviewWebView" VBox.vgrow="ALWAYS" minHeight="400"/>
                                    <Label fx:id="videosPreviewStatusLabel"
                                           text="Sélectionnez une vidéo pour voir l'aperçu"
                                           style="-fx-text-fill: #22c55e; -fx-font-size: 11px;"/>
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </Tab>
            </tabs>
        </TabPane>
    </center>

    <bottom>
        <HBox spacing="12" alignment="CENTER_RIGHT"
              style="-fx-padding: 14 20; -fx-background-color: #0f172a; -fx-border-color: #334155; -fx-border-width: 1 0 0 0;">
            <children>
                <Label fx:id="bottomStatusLabel" text="Prêt" style="-fx-text-fill: #22c55e; -fx-font-size: 11px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Fermer" onAction="#handleClose"
                        style="-fx-padding: 8 20; -fx-background-color: #334155; -fx-text-fill: #94a3b8; -fx-cursor: hand; -fx-background-radius: 8;"/>
            </children>
            <padding><Insets top="0"/></padding>
        </HBox>
    </bottom>
</BorderPane>