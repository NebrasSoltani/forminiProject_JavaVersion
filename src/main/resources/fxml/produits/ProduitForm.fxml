<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #0f172a; -fx-border-color: transparent;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="tn.formini.controllers.produits.ProduitFormController">
    <VBox spacing="20" style="-fx-padding: 30; -fx-background-color: #0f172a;">
        <children>
            <!-- Modern Header -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button text="⬅" onAction="#goBack" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-background-radius: 50; -fx-pref-width: 40; -fx-pref-height: 40; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <VBox spacing="5">
                    <Label fx:id="labelFormTitle" text="Ajouter un Produit" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Remplissez les informations ci-dessous pour ajouter un nouveau produit" style="-fx-font-size: 14px; -fx-text-fill: #94a3b8;"/>
                </VBox>
            </HBox>

            <VBox spacing="25">
                <!-- Basic Information Card -->
                <VBox spacing="20" style="-fx-background-color: #1e293b; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 5); -fx-padding: 25; -fx-border-color: #334155; -fx-border-radius: 15;">
                    <children>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="📦" style="-fx-font-size: 20px;"/>
                            <VBox spacing="2">
                                <Label text="Informations de base" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                <Label text="Nom, catégorie et description du produit" style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;"/>
                            </VBox>
                        </HBox>
                        
                        <GridPane hgap="25" vgap="20">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" minWidth="250" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="250" />
                            </columnConstraints>
                            
                            <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Nom du produit" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #94a3b8;"/>
                                <TextField fx:id="fieldNom" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-border-color: #334155; -fx-border-radius: 8; -fx-padding: 10;" promptText="Ex: MacBook Pro 14&quot;" prefHeight="45"/>
                                <Label fx:id="errNom" visible="false" style="-fx-font-size: 12px; -fx-text-fill: #ef4444;"/>
                            </VBox>

                            <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Catégorie" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #94a3b8;"/>
                                <ComboBox fx:id="fieldCategorie" maxWidth="Infinity" style="-fx-background-color: #0f172a; -fx-border-color: #334155; -fx-border-radius: 8;" promptText="Sélectionnez une catégorie" prefHeight="45"/>
                                <Label fx:id="errCategorie" visible="false" style="-fx-font-size: 12px; -fx-text-fill: #ef4444;"/>
                            </VBox>

                            <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                                <Label text="Description" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #94a3b8;"/>
                                <TextArea fx:id="fieldDescription" prefHeight="100" style="-fx-control-inner-background: #0f172a; -fx-text-fill: white; -fx-border-color: #334155; -fx-border-radius: 8;" promptText="Décrivez les caractéristiques du produit..." wrapText="true"/>
                                <Label fx:id="errDescription" visible="false" style="-fx-font-size: 12px; -fx-text-fill: #ef4444;"/>
                            </VBox>
                        </GridPane>
                    </children>
                </VBox>

                <!-- Pricing & Inventory Card -->
                <VBox spacing="20" style="-fx-background-color: #1e293b; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 5); -fx-padding: 25; -fx-border-color: #334155; -fx-border-radius: 15;">
                    <children>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="💰" style="-fx-font-size: 20px;"/>
                            <VBox spacing="2">
                                <Label text="Prix et Stock" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                <Label text="Tarification et gestion des stocks" style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;"/>
                            </VBox>
                        </HBox>
                        
                        <GridPane hgap="25" vgap="20">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" minWidth="250" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="250" />
                            </columnConstraints>
                            
                            <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Prix unitaire (DT)" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #94a3b8;"/>
                                <TextField fx:id="fieldPrix" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-border-color: #334155; -fx-border-radius: 8; -fx-padding: 10;" promptText="0.000" prefHeight="45"/>
                                <Label fx:id="errPrix" visible="false" style="-fx-font-size: 12px; -fx-text-fill: #ef4444;"/>
                            </VBox>

                            <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Quantité en stock" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #94a3b8;"/>
                                <TextField fx:id="fieldStock" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-border-color: #334155; -fx-border-radius: 8; -fx-padding: 10;" promptText="0" prefHeight="45"/>
                                <Label fx:id="errStock" visible="false" style="-fx-font-size: 12px; -fx-text-fill: #ef4444;"/>
                            </VBox>
                            <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="Date de création" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #94a3b8;"/>
                                <DatePicker fx:id="fieldDateCreation" maxWidth="Infinity" style="-fx-background-color: #0f172a; -fx-border-color: #334155; -fx-border-radius: 8;" prefHeight="45"/>
                                <Label fx:id="errDateCreation" visible="false" style="-fx-font-size: 12px; -fx-text-fill: #ef4444;"/>
                            </VBox>

                            <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Statut" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #94a3b8;"/>
                                <ComboBox fx:id="fieldStatut" maxWidth="Infinity" style="-fx-background-color: #0f172a; -fx-border-color: #334155; -fx-border-radius: 8;" promptText="Choisir statut" prefHeight="45"/>
                                <Label fx:id="errStatut" visible="false" style="-fx-font-size: 12px; -fx-text-fill: #ef4444;"/>
                            </VBox>
                        </GridPane>
                    </children>
                </VBox>

                <!-- Media Card -->
                <VBox spacing="20" style="-fx-background-color: #1e293b; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 5); -fx-padding: 25; -fx-border-color: #334155; -fx-border-radius: 15;">
                    <children>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="🖼️" style="-fx-font-size: 20px;"/>
                            <VBox spacing="2">
                                <Label text="Image du produit" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                <Label text="URL ou sélection de fichier local" style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;"/>
                            </VBox>
                        </HBox>
                        
                        <VBox spacing="15">
                            <VBox spacing="8">
                                <Label text="URL de l'image" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #94a3b8;"/>
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <TextField fx:id="fieldImage" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-border-color: #334155; -fx-border-radius: 8; -fx-padding: 10;" promptText="https://example.com/image.jpg" HBox.hgrow="ALWAYS" prefHeight="45"/>
                                    <Button text="📁" onAction="#browseImage" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-background-radius: 8; -fx-pref-width: 45; -fx-pref-height: 45; -fx-cursor: hand;"/>
                                </HBox>
                            </VBox>

                            <VBox fx:id="imagePreviewContainer" alignment="CENTER" visible="false" style="-fx-background-color: #0f172a; -fx-background-radius: 10; -fx-padding: 10; -fx-border-color: #334155; -fx-border-radius: 10; -fx-border-style: dashed;">
                                <ImageView fx:id="imagePreview" fitWidth="200" fitHeight="150" preserveRatio="true"/>
                            </VBox>
                        </VBox>
                    </children>
                </VBox>
            </VBox>

            <!-- Validation Summary Card -->
            <VBox fx:id="validationCard" visible="false" style="-fx-background-color: #450a0a; -fx-background-radius: 10; -fx-padding: 15; -fx-border-color: #991b1b; -fx-border-radius: 10;">
                <children>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="⚠️" style="-fx-font-size: 16px;"/>
                        <Label fx:id="validationSummary" text="Erreur de validation" style="-fx-text-fill: #fca5a5; -fx-font-weight: bold;"/>
                    </HBox>
                </children>
            </VBox>

            <!-- Modern Action Buttons -->
            <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 20 0 0 0;">
                <Button text="Annuler" onAction="#goBack" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-border-color: #334155; -fx-border-radius: 25; -fx-padding: 12 30; -fx-font-size: 14px; -fx-font-weight: 600; -fx-cursor: hand;"/>
                <Button fx:id="btnSave" text="🚀 Enregistrer le produit" onAction="#saveProduit" style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 12 40; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(79,70,229,0.3), 10, 0, 0, 3);"/>
            </HBox>
        </children>
    </VBox>
</ScrollPane>
