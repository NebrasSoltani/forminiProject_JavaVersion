<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" alignment="CENTER" 
      style="-fx-background-color: #FFFFFF; -fx-padding: 30;"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.formini.controllers.frontend.StripeDirectController">
    
    <!-- Titre -->
    <VBox spacing="8" alignment="CENTER">
        <Label text="💳 Stripe Direct - Interface Fonctionnelle" 
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #000000;"/>
        <Label text="Configuration directe - Pas de fichiers externes" 
               style="-fx-font-size: 16px; -fx-text-fill: #666666;"
               maxWidth="600"/>
    </VBox>
    
    <!-- Status -->
    <HBox spacing="15" alignment="CENTER">
        <Label fx:id="statusLabel" 
               text="🔄 Initialisation..." 
               style="-fx-font-size: 18px; -fx-text-fill: #333333; -fx-font-weight: 600;"/>
        <ProgressIndicator fx:id="loadingIndicator" 
                           visible="false" 
                           style="-fx-progress-color: #00D4AA;"/>
    </HBox>
    
    <!-- Formulaire de paiement -->
    <VBox spacing="15" maxWidth="700" style="-fx-background-color: #F8F9FA; -fx-background-radius: 12px; -fx-padding: 25; -fx-border-color: #E0E0E0; -fx-border-width: 2px; -fx-border-radius: 12px;">
        
        <Label text="💳 Formulaire de Paiement" 
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #000000;"/>
        
        <GridPane hgap="20" vgap="15">
            <Label text="Email client:" 
                   style="-fx-font-size: 16px; -fx-text-fill: #333333; -fx-font-weight: 600;"
                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="emailField" 
                       prefWidth="300"
                       style="-fx-font-size: 16px; -fx-padding: 12px; -fx-background-radius: 6px; -fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-width: 2px; -fx-border-radius: 6px;"
                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            
            <Label text="Montant:" 
                   style="-fx-font-size: 16px; -fx-text-fill: #333333; -fx-font-weight: 600;"
                   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="amountField" 
                       prefWidth="150"
                       style="-fx-font-size: 16px; -fx-padding: 12px; -fx-background-radius: 6px; -fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-width: 2px; -fx-border-radius: 6px;"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            
            <Label text="Devise:" 
                   style="-fx-font-size: 16px; -fx-text-fill: #333333; -fx-font-weight: 600;"
                   GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <ComboBox fx:id="currencyCombo" 
                      prefWidth="150"
                      style="-fx-font-size: 16px; -fx-padding: 12px; -fx-background-radius: 6px; -fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-width: 2px; -fx-border-radius: 6px;"
                      GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>
        
        <HBox spacing="15" alignment="CENTER">
            <Button fx:id="testButton" 
                    text="🔍 Tester Connexion" 
                    style="-fx-background-color: #635BFF; -fx-text-fill: #FFFFFF; 
                           -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 12 25; 
                           -fx-background-radius: 8px; -fx-cursor: hand;"/>
            
            <Button fx:id="payButton" 
                    text="💳 Créer Paiement" 
                    style="-fx-background-color: #00D4AA; -fx-text-fill: #FFFFFF; 
                           -fx-font-weight: bold; -fx-font-size: 18px; -fx-padding: 15 30; 
                           -fx-background-radius: 8px; -fx-cursor: hand;"/>
            
            <Button text="🔄 Réinitialiser" 
                    onAction="#resetForm"
                    style="-fx-background-color: #FFA500; -fx-text-fill: #FFFFFF; 
                           -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 20; 
                           -fx-background-radius: 6px; -fx-cursor: hand;"/>
            
            <Button text="🗑️ Effacer logs" 
                    onAction="#clearLogs"
                    style="-fx-background-color: #FF6B6B; -fx-text-fill: #FFFFFF; 
                           -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 20; 
                           -fx-background-radius: 6px; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
    
    <!-- Zone de résultats -->
    <VBox spacing="15" maxWidth="700" style="-fx-background-color: #F8F9FA; -fx-background-radius: 12px; -fx-padding: 25; -fx-border-color: #E0E0E0; -fx-border-width: 2px; -fx-border-radius: 12px;">
        
        <Label text="📋 Logs et Résultats" 
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #000000;"/>
        
        <TextArea fx:id="resultArea" 
                 prefHeight="300"
                 prefWidth="650"
                 style="-fx-font-family: 'Courier New'; -fx-font-size: 14px; -fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-width: 2px; -fx-background-radius: 6px;"/>
    </VBox>
    
</VBox>
