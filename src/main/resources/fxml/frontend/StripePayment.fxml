<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="20" alignment="CENTER" 
      style="-fx-background-color: #FFFFFF; -fx-padding: 30;"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.formini.controllers.frontend.StripePaymentController">
    
    <!-- Titre -->
    <VBox spacing="8" alignment="CENTER">
        <Label text="💳 Paiement Stripe" 
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #000000;"/>
        <Label text="Traitez vos paiements en toute sécurité" 
               style="-fx-font-size: 16px; -fx-text-fill: #666666;"
               maxWidth="400"/>
    </VBox>
    
    <!-- Conteneur principal -->
    <VBox fx:id="mainContainer" spacing="20" maxWidth="500" style="-fx-background-color: #F8F9FA; -fx-background-radius: 12px; -fx-padding: 25; -fx-border-color: #E0E0E0; -fx-border-width: 1px; -fx-border-radius: 12px;">
        
        <!-- Configuration Stripe -->
        <VBox spacing="12" alignment="CENTER">
            <Label text="Configuration Stripe" 
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #000000;"/>
            
            <Button fx:id="configureButton" 
                    text="🔑 Configurer Stripe" 
                    style="-fx-background-color: #635BFF; -fx-text-fill: #FFFFFF; 
                           -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 12 25; 
                           -fx-background-radius: 8px; -fx-cursor: hand;"/>
        </VBox>
        
        <!-- Formulaire de paiement -->
        <VBox spacing="15">
            <Label text="Détails du paiement" 
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #000000;"/>
            
            <VBox spacing="8">
                <Label text="Montant" 
                       style="-fx-font-size: 14px; -fx-text-fill: #333333; -fx-font-weight: 600;"/>
                <TextField fx:id="amountField" 
                           promptText="20.00" 
                           style="-fx-font-size: 16px; -fx-padding: 12px; -fx-background-radius: 6px; -fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-width: 2px; -fx-border-radius: 6px;"/>
            </VBox>
            
            <VBox spacing="8">
                <Label text="Devise" 
                       style="-fx-font-size: 14px; -fx-text-fill: #333333; -fx-font-weight: 600;"/>
                <ComboBox fx:id="currencyCombo" 
                          promptText="Choisir une devise" 
                          style="-fx-font-size: 14px; -fx-padding: 12px; -fx-background-radius: 6px; -fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-width: 2px;"/>
            </VBox>
        </VBox>
        
        <!-- Bouton de paiement -->
        <Button fx:id="payButton" 
                text="💳 Payer maintenant" 
                style="-fx-background-color: #00D4AA; -fx-text-fill: #FFFFFF; 
                       -fx-font-weight: bold; -fx-font-size: 18px; -fx-padding: 15 30; 
                       -fx-background-radius: 8px; -fx-cursor: hand;"/>
    </VBox>
    
    <!-- Status -->
    <VBox spacing="10" alignment="CENTER">
        <Label fx:id="statusLabel" 
               text="⚠️ Stripe non configuré" 
               style="-fx-font-size: 16px; -fx-text-fill: #666666; -fx-font-weight: 600;"
               maxWidth="500"
               wrapText="true"/>
        
        <Button text="🔄 Réinitialiser configuration" 
                onAction="#resetConfiguration"
                style="-fx-background-color: #FF6B6B; -fx-text-fill: #FFFFFF; 
                       -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 8 16; 
                       -fx-background-radius: 6px; -fx-cursor: hand;"/>
    </VBox>
    
</VBox>
