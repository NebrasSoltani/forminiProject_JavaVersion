<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="CENTER" 
      style="-fx-background-color: #FFFFFF; -fx-padding: 20;"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.formini.controllers.frontend.StripePaymentSimpleController">
    
    <!-- Titre -->
    <Label text="🔍 Test Stripe - Diagnostic" 
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #000000;"/>
    
    <!-- Zone de test -->
    <VBox spacing="10" maxWidth="600" style="-fx-background-color: #F8F9FA; -fx-padding: 20; -fx-background-radius: 8px; -fx-border-color: #E0E0E0; -fx-border-width: 1px;">
        <Label text="Test de connexion" 
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #000000;"/>
        
        <Button fx:id="testButton" 
                text="🔑 Tester connexion Stripe" 
                style="-fx-background-color: #635BFF; -fx-text-fill: #FFFFFF; 
                       -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 20; 
                       -fx-background-radius: 6px; -fx-cursor: hand;"/>
    </VBox>
    
    <!-- Zone de paiement -->
    <VBox spacing="10" maxWidth="600" style="-fx-background-color: #F8F9FA; -fx-padding: 20; -fx-background-radius: 8px; -fx-border-color: #E0E0E0; -fx-border-width: 1px;">
        <Label text="Test de paiement" 
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #000000;"/>
        
        <HBox spacing="10" alignment="CENTER">
            <Label text="Montant (EUR):" style="-fx-font-size: 14px; -fx-text-fill: #333333;"/>
            <TextField fx:id="amountField" 
                       prefWidth="120"
                       style="-fx-font-size: 14px; -fx-padding: 8px; -fx-background-radius: 4px; -fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-width: 1px;"/>
            
            <Button fx:id="payButton" 
                    text="💳 Créer paiement" 
                    style="-fx-background-color: #00D4AA; -fx-text-fill: #FFFFFF; 
                           -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 20; 
                           -fx-background-radius: 6px; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
    
    <!-- Status -->
    <Label fx:id="statusLabel" 
           text="⏳ En attente de test..." 
           style="-fx-font-size: 16px; -fx-text-fill: #666666; -fx-font-weight: 600;"/>
    
    <!-- Zone de logs -->
    <VBox spacing="10" maxWidth="600" style="-fx-background-color: #F8F9FA; -fx-padding: 15; -fx-background-radius: 8px; -fx-border-color: #E0E0E0; -fx-border-width: 1px;">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="📋 Logs de diagnostic" 
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #000000;"/>
            <Button text="🗑️ Effacer" 
                    onAction="#clearLogs"
                    style="-fx-background-color: #FF6B6B; -fx-text-fill: #FFFFFF; 
                           -fx-font-size: 12px; -fx-padding: 5 10; 
                           -fx-background-radius: 4px; -fx-cursor: hand;"/>
        </HBox>
        
        <TextArea fx:id="logArea" 
                 prefHeight="300"
                 prefWidth="570"
                 style="-fx-font-family: 'Courier New'; -fx-font-size: 12px; -fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-width: 1px; -fx-background-radius: 4px;"/>
    </VBox>
    
</VBox>
