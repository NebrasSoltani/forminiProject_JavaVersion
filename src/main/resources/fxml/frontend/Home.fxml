<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>
<?import java.net.URL?>

<!--
    Page d'accueil publique de Formini.
    Structure :
      1. Hero section
      2. Barre de filtrage par type d'événement
      3. Section Événements → ScrollPane horizontal de cartes
-->
<ScrollPane fitToWidth="true"
            vbarPolicy="AS_NEEDED" hbarPolicy="NEVER"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.formini.controllers.frontend.HomeController"
            style="-fx-background-color: #f8fafc; -fx-background: #f8fafc;">

    <stylesheets>
        <URL value="@/css/style.css"/>
        <URL value="@/css/home-cards.css"/>
    </stylesheets>

    <VBox spacing="45" style="-fx-background-color: #f8fafc;">
        <padding><Insets top="40" right="50" bottom="60" left="50"/></padding>

        <!--  HERO SECTION (Inspiration Light Theme)                            -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <HBox spacing="40" alignment="CENTER_LEFT" style="-fx-padding: 20 0 40 0;">
            <!-- Left content -->
            <VBox spacing="18" HBox.hgrow="ALWAYS" maxWidth="600">
                <Label text="ACCOMPAGNEMENT POST-FORMATION"
                       style="-fx-text-fill: #5B48D9; -fx-font-weight: 800; -fx-font-size: 11px; -fx-letter-spacing: 1.5;"/>
                
                <TextFlow lineSpacing="8">
                    <Text text="Trouvez un " style="-fx-fill: #1e293b; -fx-font-size: 38px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI', Arial, sans-serif;"/>
                    <Text text="stage" style="-fx-fill: #5B48D9; -fx-font-size: 38px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI', Arial, sans-serif;"/>
                    <Text text=" ou" style="-fx-fill: #1e293b; -fx-font-size: 38px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI', Arial, sans-serif;"/>
                    <Text text="&#10;un " style="-fx-fill: #1e293b; -fx-font-size: 38px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI', Arial, sans-serif;"/>
                    <Text text="emploi" style="-fx-fill: #b4a8ff; -fx-font-size: 38px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI', Arial, sans-serif;"/>
                    <Text text=" facilement" style="-fx-fill: #1e293b; -fx-font-size: 38px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI', Arial, sans-serif;"/>
                </TextFlow>

                <Label text="Après votre formation, nous vous aidons à postuler aux offres d'emploi et de stage publiées par nos partenaires."
                       wrapText="true"
                       style="-fx-font-size: 14px; -fx-text-fill: #64748b; -fx-line-spacing: 5;"/>

                <Button text="En Savoir Plus" 
                        style="-fx-background-color: #5B48D9; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-font-weight: bold;
                               -fx-padding: 12 30; -fx-background-radius: 25; -fx-cursor: hand;">
                    <VBox.margin><Insets top="10"/></VBox.margin>
                </Button>
            </VBox>

            <!-- Optional right side decorative element -->
            <StackPane HBox.hgrow="SOMETIMES" alignment="CENTER_RIGHT">
                <VBox alignment="CENTER" prefHeight="250" prefWidth="350" 
                      style="-fx-background-color: #eef2ff; -fx-background-radius: 40 100 40 100;">
                    <Label text="Formini Academy" style="-fx-font-size: 24px; -fx-text-fill: #5B48D9; -fx-font-weight: bold; opacity: 0.5;"/>
                </VBox>
            </StackPane>
        </HBox>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!--  BARRE DE FILTRAGE PAR TYPE                                    -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 16;
                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.07), 12, 0, 0, 3);
                     -fx-padding: 22 28;">

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="🔍" style="-fx-font-size: 20px;"/>
                <VBox spacing="2">
                    <Label text="Filtrer par type d'événement"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <Label text="Sélectionnez un type pour affiner les résultats"
                           style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
                </VBox>
            </HBox>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <VBox.margin><Insets top="14"/></VBox.margin>

                <ComboBox fx:id="filterCombo"
                          promptText="Choisir un type…"
                          prefWidth="300"
                          style="-fx-font-size: 13px; -fx-padding: 8 12;"/>

                <Button text="✕  Tout afficher"
                        onAction="#toutAfficher"
                        style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569;
                               -fx-font-size: 13px; -fx-font-weight: bold;
                               -fx-padding: 9 20; -fx-background-radius: 10; -fx-cursor: hand;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="labelResultats"
                       style="-fx-font-size: 12px; -fx-text-fill: #94a3b8; -fx-font-style: italic;"/>
            </HBox>
        </VBox>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!--  SECTION ÉVÉNEMENTS                                            -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <VBox spacing="18">
            <!-- En-tête section -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="📅" style="-fx-font-size: 22px;"/>
                <VBox spacing="3">
                    <Label text="WEBINAIRES &amp; SESSIONS LIVE"
                           style="-fx-font-size: 11px; -fx-font-weight: bold;
                                  -fx-text-fill: #10b981; -fx-letter-spacing: 1.5px;"/>
                    <Label text="Nos prochains Événements"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                </VBox>
            </HBox>

            <!-- ScrollPane horizontal — scrollbar invisible -->
            <ScrollPane hbarPolicy="NEVER" vbarPolicy="NEVER"
                        fitToHeight="true"
                        style="-fx-background-color: transparent; -fx-background: transparent;
                               -fx-padding: 4 0 10 0;">
                <HBox fx:id="eventCardsBox" spacing="20" alignment="CENTER_LEFT">
                    <padding><Insets top="6" bottom="12" left="2" right="10"/></padding>
                </HBox>
            </ScrollPane>
        </VBox>

    </VBox>
</ScrollPane>
