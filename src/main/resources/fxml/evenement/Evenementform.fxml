<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #0f172a; -fx-border-color: transparent;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="tn.formini.controllers.evenement.EvenementFormController">
    <VBox spacing="24" style="-fx-padding: 30; -fx-background-color: #0f172a;">
        <children>
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Button text="⬅" onAction="#goBack" styleClass="icon-btn" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-background-radius: 10;"/>
                <Label fx:id="labelFormTitle" text="Ajouter un Événement" style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: white;"/>
            </HBox>

            <VBox style="-fx-background-color: #1e293b; -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 5); -fx-border-color: #334155; -fx-border-radius: 20;">
                <children>
                    <GridPane hgap="30" vgap="20">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="300" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="300" />
                        </columnConstraints>

                        <!-- Section: Informations de base -->
                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Titre de l'événement *" style="-fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                            <TextField fx:id="fieldTitre" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-border-color: #334155; -fx-border-radius: 8; -fx-padding: 10;" promptText="Saisissez le titre"/>
                            <Label fx:id="errTitre" style="-fx-text-fill: #ef4444; -fx-font-size: 11px;" visible="false"/>
                        </VBox>

                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Type *" style="-fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                            <ComboBox fx:id="fieldType" maxWidth="Infinity" style="-fx-background-color: #0f172a; -fx-border-color: #334155; -fx-border-radius: 8; -fx-padding: 5;" promptText="Type d'événement"/>
                        </VBox>

                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                            <Label text="Description *" style="-fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                            <TextArea fx:id="fieldDescription" prefHeight="120" style="-fx-control-inner-background: #0f172a; -fx-text-fill: white; -fx-border-color: #334155; -fx-border-radius: 8;" promptText="Décrivez votre événement..." wrapText="true"/>
                            <Label fx:id="errDescription" style="-fx-text-fill: #ef4444; -fx-font-size: 11px;" visible="false"/>
                        </VBox>

                        <!-- Section: Détails temporels -->
                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <Label text="Date de début *" style="-fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                            <DatePicker fx:id="fieldDateDebut" maxWidth="Infinity" style="-fx-control-inner-background: #0f172a;"/>
                            <Label fx:id="errDateDebut" style="-fx-text-fill: #ef4444; -fx-font-size: 11px;" visible="false"/>
                        </VBox>
                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <Label text="Date de fin *" style="-fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                            <DatePicker fx:id="fieldDateFin" maxWidth="Infinity" style="-fx-control-inner-background: #0f172a;"/>
                            <Label fx:id="errDateFin" style="-fx-text-fill: #ef4444; -fx-font-size: 11px;" visible="false"/>
                        </VBox>

                        <!-- Lieu & Logistique -->
                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="3">
                            <Label text="Lieu / Plateforme" style="-fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                            <TextField fx:id="fieldLieu" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-border-color: #334155; -fx-border-radius: 8; -fx-padding: 10;" promptText="Localisation"/>
                        </VBox>
                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="3">
                            <Label text="Nombre de places" style="-fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                            <TextField fx:id="fieldNombrePlaces" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-border-color: #334155; -fx-border-radius: 8; -fx-padding: 10;" promptText="Capacité"/>
                        </VBox>

                        <!-- Multimédia -->
                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="4">
                            <Label text="Image principale" style="-fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <TextField fx:id="fieldImage" HBox.hgrow="ALWAYS" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-border-color: #334155; -fx-border-radius: 8; -fx-padding: 10;" promptText="URL de l'image"/>
                                <Button text="📁" onAction="#browseImage" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10;"/>
                            </HBox>
                        </VBox>
                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="4">
                            <Label text="Image 360°" style="-fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                            <TextField fx:id="fieldImage360" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-border-color: #334155; -fx-border-radius: 8; -fx-padding: 10;" promptText="URL 360° (Optionnel)"/>
                        </VBox>

                        <!-- Statut & Options -->
                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="5">
                            <Label text="Lien du Stream (Live)" style="-fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                            <TextField fx:id="fieldStreamUrl" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-border-color: #334155; -fx-border-radius: 8; -fx-padding: 10;" promptText="Lien de diffusion"/>
                        </VBox>
                        <HBox spacing="30" GridPane.columnIndex="1" GridPane.rowIndex="5" alignment="CENTER_LEFT">
                            <CheckBox fx:id="fieldIsActif" text="Actif" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                            <CheckBox fx:id="fieldLive" text="En direct (Live)" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                        </HBox>

                        <!-- Catégorisation -->
                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="6">
                            <Label text="Tags" style="-fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                            <TextField fx:id="fieldTags" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-border-color: #334155; -fx-border-radius: 8; -fx-padding: 10;" promptText="Tags (séparés par des virgules)"/>
                        </VBox>
                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="6">
                            <Label text="Filières" style="-fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                            <TextField fx:id="fieldFilieres" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-border-color: #334155; -fx-border-radius: 8; -fx-padding: 10;" promptText="Filières concernées"/>
                        </VBox>
                    </GridPane>
                </children>
            </VBox>

            <HBox spacing="20" alignment="CENTER_RIGHT">
                <Button text="Annuler" onAction="#goBack" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-border-color: #334155; -fx-border-radius: 25; -fx-padding: 12 30; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button fx:id="btnSave" text="🚀 Enregistrer l'événement" onAction="#saveEvenement" style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 12 40; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(79,70,229,0.3), 10, 0, 0, 3);"/>
            </HBox>
        </children>
    </VBox>
</ScrollPane>