<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.formini.controllers.evenement.EvenementListController"
      spacing="20" styleClass="content-area">

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="📅 Liste des Événements" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="📊 Statistiques" onAction="#showEventStats" style="-fx-background-color: #6974e8; -fx-text-fill: white; -fx-padding: 8 15; -fx-background-radius: 8; -fx-cursor: hand;"/>
        <Button text="➕ Nouvel Événement" onAction="#goToAdd" styleClass="nav-btn-active"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="topbar" style="-fx-background-radius: 10;">
        <TextField fx:id="searchField" promptText="Rechercher par nom..." prefWidth="200"/>
        <ComboBox fx:id="filterType" promptText="Type" prefWidth="150"/>
        <ComboBox fx:id="sortOptions" promptText="Trier par..." prefWidth="150"/>
        <CheckBox fx:id="filterLive" text="Live 🔴"/>
        <CheckBox fx:id="filterActif" text="Actif"/>
        <Button text="Réinitialiser" onAction="#resetFilters" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-padding: 6 15; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="labelCount" text="0 événement(s)" styleClass="topbar-date"/>
    </HBox>

    <StackPane VBox.vgrow="ALWAYS">
        <ScrollPane fitToWidth="true" styleClass="scroll-pane" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-width: 0;">
            <FlowPane fx:id="eventGrid" hgap="25" vgap="25" prefWrapLength="800" style="-fx-padding: 10;"/>
        </ScrollPane>

        <!-- Statistics Side Panel (Overlay) -->
        <VBox fx:id="statsContainer" visible="false" managed="false" StackPane.alignment="CENTER_RIGHT"
              maxWidth="450" minWidth="450" spacing="10" 
              style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 20 0 0 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20, 0, -10, 0);">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="📊 Statistiques Détaillées" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="✕" onAction="#hideStats" style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b; -fx-font-size: 14px; -fx-background-radius: 50; -fx-min-width: 35; -fx-min-height: 35; -fx-cursor: hand;"/>
            </HBox>
            
            <Separator style="-fx-padding: 10 0;"/>
            
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-width: 0;" VBox.vgrow="ALWAYS">
                <VBox fx:id="statsContent" spacing="20">
                    <padding>
                        <Insets bottom="20" left="5" right="5" top="10"/>
                    </padding>
                </VBox>
            </ScrollPane>
        </VBox>
    </StackPane>

    <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 10;">
        <Pagination fx:id="pagination" pageCount="1" maxPageIndicatorCount="5"/>
    </HBox>

</VBox>