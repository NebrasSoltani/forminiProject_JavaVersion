<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.*?>
<?import java.net.URL?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="tn.formini.controllers.crud.ApprenantFormController"
           styleClass="signup-page"
           minHeight="400">

    <stylesheets>
        <URL value="@../../css/style.css" />
    </stylesheets>

    <!-- Decorative Background Elements -->
    <StackPane StackPane.alignment="TOP_LEFT">
        <Circle radius="200" fill="linear-gradient(to bottom right, #4f46e5 0%, #1e1b4b 100%)"
                opacity="0.1" StackPane.alignment="TOP_LEFT"
                translateX="-100" translateY="-100"/>
    </StackPane>

    <StackPane StackPane.alignment="BOTTOM_RIGHT">
        <Circle radius="250" fill="linear-gradient(to bottom right, #1e293b 0%, #0f172a 100%)"
                opacity="0.15" StackPane.alignment="BOTTOM_RIGHT"
                translateX="150" translateY="150"/>
    </StackPane>

    <VBox alignment="TOP_CENTER" spacing="0" StackPane.alignment="TOP_CENTER">
        <padding><Insets top="28" right="24" bottom="28" left="24"/></padding>

        <VBox maxWidth="720" spacing="20" alignment="TOP_CENTER" styleClass="signup-column">

            <!-- Back to Dashboard Button -->
            <HBox alignment="CENTER_LEFT">
                <Button text="← Retour au tableau de bord" onAction="#handleCancelButton" styleClass="btn-secondary" style="-fx-font-size: 12px; -fx-padding: 4 8;"/>
            </HBox>

            <!-- En-tête -->
            <VBox spacing="8" alignment="CENTER" styleClass="signup-hero">
                <Label fx:id="formTitle" text="CRÉER UN COMPTE APPRENANT" styleClass="signup-hero-title" style="-fx-font-size: 32px;"/>
                <Label fx:id="formSubtitle" text="Rejoignez la communauté Formini en tant qu'apprenant et commencez votre parcours d'apprentissage."
                       wrapText="true" styleClass="signup-hero-sub" maxWidth="680" alignment="CENTER"/>
            </VBox>

            <Label fx:id="lblMessage" styleClass="signup-alert" wrapText="true" maxWidth="680" visible="false" managed="false"/>

            <!-- Carte formulaire -->
            <VBox styleClass="signup-card" spacing="0" VBox.vgrow="ALWAYS">
                <ScrollPane fitToWidth="true" styleClass="signup-scroll" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                    <VBox spacing="28" styleClass="signup-card-inner">
                        <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

                        <!-- Rôle -->
                        <VBox spacing="14">
                            <Label text="Je m'inscris comme" styleClass="signup-section-kicker"/>
                            <Label text="Type de compte" styleClass="signup-section-title"/>
                            <HBox spacing="14" alignment="CENTER_LEFT" styleClass="signup-role-row">
                                <VBox fx:id="roleTileApprenant" styleClass="signup-role-tile signup-role-tile-selected" HBox.hgrow="ALWAYS" spacing="6">
                                    <RadioButton fx:id="rbApprenant" text="Apprenant" selected="true" styleClass="signup-role-radio"/>
                                    <Label text="Accéder aux formations et développer mes compétences" styleClass="signup-role-hint" wrapText="true"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <Separator styleClass="signup-sep"/>



                        <!-- Identité -->
                        <VBox spacing="16">
                            <VBox spacing="4">
                                <Label text="Étape 1" styleClass="signup-section-kicker"/>
                                <Label text="Identité &amp; connexion" styleClass="signup-section-title"/>
                            </VBox>
                            <GridPane hgap="18" vgap="18" styleClass="signup-grid">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="140" percentWidth="50"/>
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="140" percentWidth="50"/>
                                </columnConstraints>

                                <VBox styleClass="form-group" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Email *" styleClass="form-label"/>
                                    <TextField fx:id="emailTextField" styleClass="form-control signup-field" promptText="vous@exemple.tn"/>
                                    <Label fx:id="errorEmail" styleClass="error-label" text="" visible="false" managed="false"/>
                                </VBox>
                                <VBox styleClass="form-group" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Téléphone *" styleClass="form-label"/>
                                    <TextField fx:id="telephoneTextField" styleClass="form-control signup-field" promptText="8 à 12 chiffres, ex. 22345678 ou +21622334455"/>
                                    <Label fx:id="errorTelephone" styleClass="error-label" text="" visible="false" managed="false"/>
                                </VBox>

                                <VBox styleClass="form-group" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label text="Mot de passe *" styleClass="form-label"/>
                                    <HBox spacing="8" alignment="CENTER_RIGHT">
                                        <PasswordField fx:id="passwordField" styleClass="form-control signup-field" promptText="8+ caractères, maj., min., chiffre" HBox.hgrow="ALWAYS"/>
                                        <Button fx:id="btnTogglePassword" styleClass="btn-toggle-password-icon" onAction="#onTogglePassword">
                                            <graphic>
                                                <StackPane>
                                                    <Label fx:id="eyeIcon" text="&#x1F441;" styleClass="icon-eye"/>
                                                    <Label fx:id="eyeSlashIcon" text="&#x1F441;&#x200D;&#x1F5E8;" styleClass="icon-eye-slash" visible="false" managed="false"/>
                                                </StackPane>
                                            </graphic>
                                        </Button>
                                    </HBox>
                                    <Label fx:id="errorPassword" styleClass="error-label" text="" visible="false" managed="false"/>
                                </VBox>
                                <VBox styleClass="form-group" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <Label text="Confirmer *" styleClass="form-label"/>
                                    <HBox spacing="8" alignment="CENTER_RIGHT">
                                        <PasswordField fx:id="passwordConfirmField" styleClass="form-control signup-field" promptText="Même mot de passe" HBox.hgrow="ALWAYS"/>
                                        <Button fx:id="btnTogglePasswordConfirm" styleClass="btn-toggle-password-icon" onAction="#onTogglePasswordConfirm">
                                            <graphic>
                                                <StackPane>
                                                    <Label fx:id="eyeIconConfirm" text="&#x1F441;" styleClass="icon-eye"/>
                                                    <Label fx:id="eyeSlashIconConfirm" text="&#x1F441;&#x200D;&#x1F5E8;" styleClass="icon-eye-off" visible="false" managed="false"/>
                                                </StackPane>
                                            </graphic>
                                        </Button>
                                    </HBox>
                                    <Label fx:id="errorPasswordConfirm" styleClass="error-label" text="" visible="false" managed="false"/>
                                </VBox>

                                <VBox styleClass="form-group" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <Label text="Nom *" styleClass="form-label"/>
                                    <TextField fx:id="nomTextField" styleClass="form-control signup-field" promptText="Nom de famille"/>
                                    <Label fx:id="errorNom" styleClass="error-label" text="" visible="false" managed="false"/>
                                </VBox>
                                <VBox styleClass="form-group" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <Label text="Prénom *" styleClass="form-label"/>
                                    <TextField fx:id="prenomTextField" styleClass="form-control signup-field" promptText="Prénom"/>
                                    <Label fx:id="errorPrenom" styleClass="error-label" text="" visible="false" managed="false"/>
                                </VBox>

                                <VBox styleClass="form-group" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                    <Label text="Genre" styleClass="form-label"/>
                                    <ComboBox fx:id="genreComboBox" styleClass="form-control signup-field" maxWidth="Infinity" promptText="Choisir"/>
                                </VBox>
                                <VBox styleClass="form-group" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                    <Label text="État civil" styleClass="form-label"/>
                                    <ComboBox fx:id="etatCivilComboBox" styleClass="form-control signup-field" maxWidth="Infinity" promptText="Choisir"/>
                                </VBox>

                                <VBox styleClass="form-group" GridPane.columnIndex="0" GridPane.rowIndex="4">
                                    <Label text="Gouvernorat" styleClass="form-label"/>
                                    <ComboBox fx:id="gouvernoratComboBox" styleClass="form-control signup-field" maxWidth="Infinity" promptText="Choisir"/>
                                </VBox>
                                <VBox styleClass="form-group" GridPane.columnIndex="1" GridPane.rowIndex="4">
                                    <Label text="Date de naissance *" styleClass="form-label"/>
                                    <DatePicker fx:id="dateNaissanceField" styleClass="form-control signup-field" maxWidth="Infinity" promptText="JJ/MM/AAAA"/>
                                    <Label fx:id="errorDateNaissance" styleClass="error-label" text="" visible="false" managed="false"/>
                                </VBox>

                                <VBox styleClass="form-group" GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.columnSpan="2">
                                    <Label text="Photo de profil" styleClass="form-label"/>
                                    <HBox spacing="12" alignment="CENTER_LEFT">
                                        <VBox spacing="8" alignment="CENTER">
                                            <ImageView fx:id="imageViewPhoto" fitWidth="100" fitHeight="100" preserveRatio="true"/>
                                        </VBox>
                                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                                            <HBox spacing="8" alignment="CENTER_LEFT">
                                                <Button fx:id="btnUploadPhoto" text="Choisir une photo" styleClass="btn-secondary signup-btn-upload" onAction="#onUploadPhoto"/>
                                                <Label fx:id="lblPhotoFileName" text="Aucune photo sélectionnée" styleClass="signup-file-name"/>
                                            </HBox>
                                            <TextField fx:id="photoField" styleClass="form-control signup-field" promptText="Ou lien URL vers photo"/>
                                        </VBox>
                                    </HBox>
                                </VBox>

                                <VBox styleClass="form-group" GridPane.columnIndex="0" GridPane.rowIndex="6" GridPane.columnSpan="2">
                                                                    </VBox>
                            </GridPane>
                            <Label text="Mot de passe : au moins 8 caractères, une majuscule, une minuscule et un chiffre."
                                   styleClass="signup-field-hint" wrapText="true"/>
                        </VBox>

                        <Separator styleClass="signup-sep"/>

                        <!-- Profil apprenant -->
                        <VBox fx:id="panelApprenant" spacing="18">
                            <VBox spacing="4">
                                <Label text="Profil apprenant" styleClass="signup-section-kicker"/>
                                <Label text="Définissez vos objectifs d'apprentissage" styleClass="signup-section-title"/>
                            </VBox>
                            <GridPane hgap="18" vgap="18" styleClass="signup-grid">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                </columnConstraints>
                                <VBox styleClass="form-group" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2">
                                    <Label text="Objectif d'apprentissage *" styleClass="form-label"/>
                                    <TextField fx:id="objectifTextField" styleClass="form-control signup-field" promptText="Ex: Devenir développeur Java, acquérir des compétences en UX..."/>
                                    <Label fx:id="errorObjectif" styleClass="error-label" text="" visible="false" managed="false"/>
                                </VBox>
                                <VBox styleClass="form-group" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                                    <Label text="Domaines d'intérêt" styleClass="form-label"/>
                                    <TextArea fx:id="domainesInteretTextArea" styleClass="form-control signup-field signup-textarea" prefRowCount="4" wrapText="true" promptText="Décrivez les domaines qui vous intéressent : développement web, design, marketing..."/>
                                </VBox>
                                <VBox styleClass="form-group" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <Label text="Niveau actuel" styleClass="form-label"/>
                                    <ComboBox fx:id="niveauComboBox" styleClass="form-control signup-field" maxWidth="Infinity" promptText="Choisir votre niveau"/>
                                </VBox>
                                <VBox styleClass="form-group" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <Label text="Disponibilité" styleClass="form-label"/>
                                    <ComboBox fx:id="disponibiliteComboBox" styleClass="form-control signup-field" maxWidth="Infinity" promptText="Temps disponible par semaine"/>
                                </VBox>
                            </GridPane>
                        </VBox>
                    </VBox>
                </ScrollPane>



                <!-- Pied de carte : actions -->
                <HBox spacing="14" alignment="CENTER" styleClass="signup-actions" style="-fx-padding: 20 0 30 0;">
                    <Button text="Annuler" onAction="#handleCancelButton" styleClass="btn-secondary" prefWidth="120"/>
                    <Button fx:id="saveButton" text="CRÉER MON COMPTE" onAction="#handleSaveButton" styleClass="signup-btn-primary" prefWidth="240"/>
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</StackPane>
