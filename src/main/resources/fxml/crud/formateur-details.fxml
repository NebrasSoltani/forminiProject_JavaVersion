<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.*?>
<?import java.net.URL?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="tn.formini.controllers.crud.FormateurDetailsController"
           styleClass="signup-page"
           minHeight="400">

    <stylesheets>
        <URL value="@../../css/style.css" />
    </stylesheets>

    <!-- Decorative Background Elements -->
    <StackPane StackPane.alignment="TOP_LEFT">
        <Circle radius="200" fill="linear-gradient(to bottom right, #4f46e5 0%, #1e1b4b 100%)"
                opacity="0.1" StackPane.alignment="TOP_LEFT"
                translateX="-100" translateY="-100"/>
    </StackPane>

    <StackPane StackPane.alignment="BOTTOM_RIGHT">
        <Circle radius="250" fill="linear-gradient(to bottom right, #1e293b 0%, #0f172a 100%)"
                opacity="0.15" StackPane.alignment="BOTTOM_RIGHT"
                translateX="150" translateY="150"/>
    </StackPane>

    <VBox alignment="TOP_CENTER" spacing="0" StackPane.alignment="TOP_CENTER">
        <padding><Insets top="28" right="24" bottom="28" left="24"/></padding>

        <VBox maxWidth="720" spacing="20" alignment="TOP_CENTER" styleClass="signup-column">

            <!-- Back to Dashboard Button -->
            <HBox alignment="CENTER_LEFT">
                <Button text="← Retour à la liste" onAction="#handleCloseButton" styleClass="btn-secondary" style="-fx-font-size: 12px; -fx-padding: 4 8;"/>
            </HBox>

            <!-- En-tête -->
            <VBox spacing="8" alignment="CENTER" styleClass="signup-hero">
                <Label text="DÉTAILS FORMATEUR" styleClass="signup-hero-title" style="-fx-font-size: 32px;"/>
                <Label fx:id="heroSubLabel" text="Informations complètes sur le formateur"
                       wrapText="true" styleClass="signup-hero-sub" maxWidth="680" alignment="CENTER"/>
            </VBox>

            <!-- Carte formulaire -->
            <VBox styleClass="signup-card" spacing="0" VBox.vgrow="ALWAYS">
                <ScrollPane fitToWidth="true" styleClass="signup-scroll" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                    <VBox spacing="28" styleClass="signup-card-inner">
                        <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

                        <!-- Rôle -->
                        <VBox spacing="14">
                            <Label text="Type de compte" styleClass="signup-section-kicker"/>
                            <Label text="Rôle" styleClass="signup-section-title"/>
                            <HBox spacing="14" alignment="CENTER_LEFT" styleClass="signup-role-row">
                                <VBox fx:id="roleTileApprenant" styleClass="signup-role-tile" HBox.hgrow="ALWAYS" spacing="6">
                                    <Label text="Apprenant" styleClass="signup-role-hint" wrapText="true"/>
                                </VBox>
                                <VBox fx:id="roleTileFormateur" styleClass="signup-role-tile signup-role-tile-selected" HBox.hgrow="ALWAYS" spacing="6">
                                    <Label text="Formateur" styleClass="signup-role-hint" wrapText="true"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <Separator styleClass="signup-sep"/>

                        <!-- Identité -->
                        <VBox spacing="16">
                            <VBox spacing="4">
                                <Label text="Étape 1" styleClass="signup-section-kicker"/>
                                <Label text="Identité &amp; connexion" styleClass="signup-section-title"/>
                            </VBox>
                            <GridPane hgap="18" vgap="18" styleClass="signup-grid">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="140" percentWidth="50"/>
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="140" percentWidth="50"/>
                                </columnConstraints>

                                <VBox styleClass="form-group" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Email" styleClass="form-label"/>
                                    <Label fx:id="emailLabel" styleClass="form-control signup-field" style="-fx-background-color: #f8f9fa; -fx-padding: 8 12; -fx-border-radius: 6;"/>
                                </VBox>
                                <VBox styleClass="form-group" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Téléphone" styleClass="form-label"/>
                                    <Label fx:id="telephoneLabel" styleClass="form-control signup-field" style="-fx-background-color: #f8f9fa; -fx-padding: 8 12; -fx-border-radius: 6;"/>
                                </VBox>

                                <VBox styleClass="form-group" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label text="Nom" styleClass="form-label"/>
                                    <Label fx:id="nomLabel" styleClass="form-control signup-field" style="-fx-background-color: #f8f9fa; -fx-padding: 8 12; -fx-border-radius: 6;"/>
                                </VBox>
                                <VBox styleClass="form-group" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <Label text="Prénom" styleClass="form-label"/>
                                    <Label fx:id="prenomLabel" styleClass="form-control signup-field" style="-fx-background-color: #f8f9fa; -fx-padding: 8 12; -fx-border-radius: 6;"/>
                                </VBox>

                                <VBox styleClass="form-group" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <Label text="Gouvernorat" styleClass="form-label"/>
                                    <Label fx:id="gouvernoratLabel" styleClass="form-control signup-field" style="-fx-background-color: #f8f9fa; -fx-padding: 8 12; -fx-border-radius: 6;"/>
                                </VBox>
                                <VBox styleClass="form-group" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <Label text="Date de naissance" styleClass="form-label"/>
                                    <Label fx:id="dateNaissanceLabel" styleClass="form-control signup-field" style="-fx-background-color: #f8f9fa; -fx-padding: 8 12; -fx-border-radius: 6;"/>
                                </VBox>

                                <VBox styleClass="form-group" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                                    <Label text="Photo de profil" styleClass="form-label"/>
                                    <HBox spacing="12" alignment="CENTER_LEFT">
                                        <VBox spacing="8" alignment="CENTER">
                                            <ImageView fx:id="imageViewPhoto" fitWidth="100" fitHeight="100" preserveRatio="true"/>
                                        </VBox>
                                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                                            <Label fx:id="photoFileName" text="Photo du profil" styleClass="signup-file-name"/>
                                        </VBox>
                                    </HBox>
                                </VBox>
                            </GridPane>
                        </VBox>

                        <Separator styleClass="signup-sep"/>

                        <!-- Profil formateur -->
                        <VBox fx:id="panelFormateur" spacing="18">
                            <VBox spacing="4">
                                <Label text="Profil formateur" styleClass="signup-section-kicker"/>
                                <Label text="Présentation de l'expertise" styleClass="signup-section-title"/>
                            </VBox>
                            <GridPane hgap="18" vgap="18" styleClass="signup-grid">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                </columnConstraints>
                                <VBox styleClass="form-group" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2">
                                    <Label text="Spécialité" styleClass="form-label"/>
                                    <Label fx:id="specialiteLabel" styleClass="form-control signup-field" style="-fx-background-color: #f8f9fa; -fx-padding: 8 12; -fx-border-radius: 6;"/>
                                </VBox>
                                <VBox styleClass="form-group" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                                    <Label text="Bio" styleClass="form-label"/>
                                    <Label fx:id="bioLabel" styleClass="form-control signup-field signup-textarea" style="-fx-background-color: #f8f9fa; -fx-padding: 12 16; -fx-border-radius: 6; -fx-wrap-text: true;" prefHeight="80"/>
                                </VBox>
                                <VBox styleClass="form-group" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <Label text="Années d'expérience" styleClass="form-label"/>
                                    <Label fx:id="experienceLabel" styleClass="form-control signup-field" style="-fx-background-color: #f8f9fa; -fx-padding: 8 12; -fx-border-radius: 6;"/>
                                </VBox>
                                <VBox styleClass="form-group" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <Label text="LinkedIn" styleClass="form-label"/>
                                    <Hyperlink fx:id="linkedinLink" styleClass="form-control signup-field" style="-fx-background-color: #f8f9fa; -fx-padding: 8 12; -fx-border-radius: 6;"/>
                                </VBox>
                                <VBox styleClass="form-group" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                    <Label text="Portfolio" styleClass="form-label"/>
                                    <Hyperlink fx:id="portfolioLink" styleClass="form-control signup-field" style="-fx-background-color: #f8f9fa; -fx-padding: 8 12; -fx-border-radius: 6;"/>
                                </VBox>
                                <VBox styleClass="form-group" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                    <Label text="CV" styleClass="form-label"/>
                                    <Hyperlink fx:id="cvLink" styleClass="form-control signup-field" style="-fx-background-color: #f8f9fa; -fx-padding: 8 12; -fx-border-radius: 6;"/>
                                </VBox>
                                <VBox styleClass="form-group" GridPane.columnIndex="0" GridPane.rowIndex="4">
                                    <Label text="ID Formateur" styleClass="form-label"/>
                                    <Label fx:id="idLabel" styleClass="form-control signup-field" style="-fx-background-color: #f8f9fa; -fx-padding: 8 12; -fx-border-radius: 6;"/>
                                </VBox>
                                <VBox styleClass="form-group" GridPane.columnIndex="1" GridPane.rowIndex="4">
                                    <Label text="Note moyenne" styleClass="form-label"/>
                                    <Label fx:id="noteMoyenneLabel" styleClass="form-control signup-field" style="-fx-background-color: #f8f9fa; -fx-padding: 8 12; -fx-border-radius: 6;"/>
                                </VBox>
                            </GridPane>
                        </VBox>
                    </VBox>
                </ScrollPane>

                <!-- Pied de carte : actions -->
                <HBox spacing="14" alignment="CENTER" styleClass="signup-actions" style="-fx-padding: 20 0 30 0;">
                    <Button text="Retour à la liste" onAction="#handleCloseButton" styleClass="btn-secondary" prefWidth="150"/>
                    <Button fx:id="editButton" text="MODIFIER" onAction="#handleEditButton" styleClass="signup-btn-primary" prefWidth="150"/>
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</StackPane>
