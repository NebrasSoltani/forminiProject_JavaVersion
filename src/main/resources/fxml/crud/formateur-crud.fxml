<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.formini.controllers.crud.FormateurCrudController"
      style="-fx-background-color: #0f172a;"
      prefWidth="1280" prefHeight="860">

    <!-- ══════════════════════════════════════════════════════════════════════
         MAIN CONTENT
         ══════════════════════════════════════════════════════════════════════ -->
    <VBox spacing="0">

        <!-- Top header bar -->
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: linear-gradient(to bottom right, #1e293b, #0f172a); -fx-padding: 22 30; -fx-border-color: #1e293b; -fx-border-width: 0 0 1 0;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 15, 0, 0, 5);">
            <VBox spacing="4">
                <Label text="Gestion des Formateurs"
                       style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                <Label text="Gérez les informations, spécialités et expériences des formateurs"
                       style="-fx-font-size: 12px; -fx-text-fill: #38bdf8; -fx-font-weight: bold;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- Count pill -->
            <HBox spacing="6" alignment="CENTER"
                  style="-fx-background-color: rgba(56,189,248,0.1); -fx-background-radius: 20; -fx-padding: 8 18; -fx-border-color: rgba(56,189,248,0.25); -fx-border-width: 1; -fx-border-radius: 20;">
                <Label text="👨‍🏫" style="-fx-font-size: 12px;"/>
                <Label fx:id="countLabel" text="Total: 0 formateurs"
                       style="-fx-font-size: 12px; -fx-text-fill: #38bdf8; -fx-font-weight: bold;"/>
            </HBox>
            <!-- Primary add button -->
            <Button fx:id="addButton" text="+ Ajouter un Formateur" onAction="#handleAddButton"
                    style="-fx-background-color: #38bdf8; -fx-text-fill: #0f172a; -fx-font-size: 13px; -fx-font-weight: 900; -fx-background-radius: 22; -fx-padding: 10 24; -fx-cursor: hand; -fx-border-width: 0;
                           -fx-effect: dropshadow(gaussian, rgba(56,189,248,0.35), 12, 0, 0, 4);"/>
        </HBox>

        <!-- Scrollable body -->
        <VBox VBox.vgrow="ALWAYS" spacing="18">
            <padding><Insets top="22" right="28" bottom="16" left="28"/></padding>

            <!-- ── SEARCH + FILTER PANEL ───────────────────────────────────── -->
            <VBox spacing="16"
                  style="-fx-background-color: #1e293b; -fx-background-radius: 16; -fx-border-color: #334155; -fx-border-width: 1; -fx-border-radius: 16; -fx-padding: 22 24;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 12, 0, 0, 4);">

                <!-- Row 1: Scope selector + main search -->
                <HBox spacing="12" alignment="BOTTOM_LEFT">

                    <VBox spacing="6">
                        <Label text="CHAMP DE RECHERCHE"
                               style="-fx-font-size: 10px; -fx-font-weight: 900; -fx-text-fill: #475569;"/>
                        <ComboBox fx:id="searchScopeComboBox" prefWidth="160" prefHeight="42"
                                  promptText="Tous les champs"
                                  style="-fx-background-color: #0f172a; -fx-background-radius: 10; -fx-border-color: #334155; -fx-border-width: 1; -fx-border-radius: 10;"/>
                    </VBox>

                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="RECHERCHE GLOBALE"
                               style="-fx-font-size: 10px; -fx-font-weight: 900; -fx-text-fill: #475569;"/>
                        <HBox>
                            <TextField fx:id="searchField" prefHeight="42"
                                       promptText="  🔍  Nom, spécialité, email, bio..."
                                       style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-prompt-text-fill: #475569; -fx-font-size: 13px; -fx-border-color: #334155 transparent #334155 #334155; -fx-border-width: 1; -fx-border-radius: 10 0 0 10; -fx-background-radius: 10 0 0 10; -fx-padding: 0 16;"
                                       HBox.hgrow="ALWAYS"/>
                            <Button fx:id="searchButton" text="Rechercher" onAction="#handleSearch"
                                    prefHeight="42"
                                    style="-fx-background-color: #38bdf8; -fx-text-fill: #0f172a; -fx-font-weight: 900; -fx-font-size: 13px; -fx-background-radius: 0 10 10 0; -fx-padding: 0 24; -fx-cursor: hand; -fx-border-width: 0;"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Separator label -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="▸ FILTRES &amp; TRI"
                           style="-fx-font-size: 10px; -fx-font-weight: 900; -fx-text-fill: #475569;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="statusLabel" text=""
                           style="-fx-font-size: 11px; -fx-text-fill: #38bdf8; -fx-font-weight: bold;"/>
                </HBox>

                <!-- Row 2: Advanced filters -->
                <HBox spacing="12" alignment="BOTTOM_LEFT">

                    <VBox spacing="6">
                        <Label text="SPÉCIALITÉ"
                               style="-fx-font-size: 10px; -fx-font-weight: 900; -fx-text-fill: #475569;"/>
                        <TextField fx:id="specialiteFilterField" prefWidth="185" prefHeight="38"
                                   promptText="Ex: Java, Web..."
                                   style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-prompt-text-fill: #475569; -fx-border-color: #334155; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 0 14; -fx-font-size: 12px;"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="NOTE MINIMALE"
                               style="-fx-font-size: 10px; -fx-font-weight: 900; -fx-text-fill: #475569;"/>
                        <ComboBox fx:id="minNoteComboBox" prefWidth="160" prefHeight="38"
                                  promptText="Note min..."
                                  style="-fx-background-color: #0f172a; -fx-background-radius: 10; -fx-border-color: #334155; -fx-border-width: 1; -fx-border-radius: 10;"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="TRIER PAR"
                               style="-fx-font-size: 10px; -fx-font-weight: 900; -fx-text-fill: #475569;"/>
                        <ComboBox fx:id="sortByComboBox" prefWidth="148" prefHeight="38"
                                  promptText="Trier par..."
                                  style="-fx-background-color: #0f172a; -fx-background-radius: 10; -fx-border-color: #334155; -fx-border-width: 1; -fx-border-radius: 10;"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="ORDRE"
                               style="-fx-font-size: 10px; -fx-font-weight: 900; -fx-text-fill: #475569;"/>
                        <ComboBox fx:id="sortDirectionComboBox" prefWidth="148" prefHeight="38"
                                  promptText="Ordre..."
                                  style="-fx-background-color: #0f172a; -fx-background-radius: 10; -fx-border-color: #334155; -fx-border-width: 1; -fx-border-radius: 10;"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Filter action buttons -->
                    <VBox spacing="6" alignment="BOTTOM_RIGHT">
                        <Label text=" " style="-fx-font-size: 10px;"/>
                        <HBox spacing="8">
                            <Button fx:id="filterButton" text="⚡ Filtrer" onAction="#handleFilter"
                                    prefHeight="38"
                                    style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-background-radius: 10; -fx-padding: 0 18; -fx-cursor: hand; -fx-border-width: 0;"/>
                            <Button fx:id="sortButton" text="↕ Trier" onAction="#handleSort"
                                    prefHeight="38"
                                    style="-fx-background-color: #0f9d58; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-background-radius: 10; -fx-padding: 0 18; -fx-cursor: hand; -fx-border-width: 0;"/>
                            <Button fx:id="resetFiltersButton" text="✕ Réinitialiser" onAction="#handleResetFilters"
                                    prefHeight="38"
                                    style="-fx-background-color: rgba(239,68,68,0.1); -fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-font-size: 12px; -fx-background-radius: 10; -fx-padding: 0 16; -fx-cursor: hand; -fx-border-color: rgba(239,68,68,0.25); -fx-border-width: 1; -fx-border-radius: 10;"/>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>

            <!-- ── RESULTS HEADER + CRUD ACTIONS ──────────────────────────── -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="📋  Résultats"
                       style="-fx-font-size: 15px; -fx-font-weight: 900; -fx-text-fill: #94a3b8;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="viewDetailsButton" text="👁  Détails" onAction="#handleViewDetailsButton" disable="true"
                        style="-fx-background-color: rgba(56,189,248,0.1); -fx-text-fill: #38bdf8; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 18; -fx-cursor: hand; -fx-border-width: 1; -fx-border-color: rgba(56,189,248,0.3); -fx-border-radius: 20;"/>
                <Button fx:id="editButton" text="✏  Modifier" onAction="#handleEditButton" disable="true"
                        style="-fx-background-color: rgba(244,180,0,0.1); -fx-text-fill: #f4b400; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 18; -fx-cursor: hand; -fx-border-width: 1; -fx-border-color: rgba(244,180,0,0.3); -fx-border-radius: 20;"/>
                <Button fx:id="deleteButton" text="🗑  Supprimer" onAction="#handleDeleteButton" disable="true"
                        style="-fx-background-color: rgba(239,68,68,0.1); -fx-text-fill: #ef4444; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 18; -fx-cursor: hand; -fx-border-width: 1; -fx-border-color: rgba(239,68,68,0.3); -fx-border-radius: 20;"/>
                <Button fx:id="refreshButton" text="🔄  Actualiser" onAction="#handleRefreshButton"
                        style="-fx-background-color: rgba(107,114,128,0.1); -fx-text-fill: #6b7280; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 18; -fx-cursor: hand; -fx-border-width: 1; -fx-border-color: rgba(107,114,128,0.3); -fx-border-radius: 20;"/>
            </HBox>

            <!-- ── CARDS SCROLL AREA ───────────────────────────────────────── -->
            <ScrollPane fx:id="cardsScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-width: 0; -fx-padding: 0;">
                <content>
                    <FlowPane fx:id="cardsFlowPane" hgap="18" vgap="18"
                              style="-fx-background-color: transparent; -fx-padding: 2;"/>
                </content>
            </ScrollPane>

            <!-- ── FOOTER: status + pagination ────────────────────────────── -->
            <HBox alignment="CENTER_LEFT" spacing="20"
                  style="-fx-background-color: #1e293b; -fx-background-radius: 12; -fx-padding: 12 20; -fx-border-color: #334155; -fx-border-width: 1; -fx-border-radius: 12;">
                <Label fx:id="lastUpdateLabel" text="Dernière mise à jour: --:--"
                       style="-fx-font-size: 11px; -fx-text-fill: #475569;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Pagination fx:id="pagination" pageCount="1" maxPageIndicatorCount="7"/>
            </HBox>

        </VBox>
    </VBox>

</VBox>
