<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox spacing="30" style="-fx-background-color: #0f172a; -fx-padding: 40;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.formini.controllers.dashboard.ApprenantDashboardController">
    <children>
        <!-- Header Section -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <children>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label fx:id="titleLabel" text="Tableau de Bord Apprenant" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                    <Label fx:id="welcomeLabel" text="Ravi de vous revoir !" style="-fx-font-size: 16px; -fx-text-fill: #94a3b8;"/>
                </VBox>
                <Button onAction="#refreshDashboard" text="🔄 Actualiser" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 20; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </children>
        </HBox>

        <!-- Stats Grid -->
        <FlowPane hgap="25" vgap="25">
            <children>
                <!-- Formations Card -->
                <VBox prefWidth="240" style="-fx-background-color: #1e293b; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 5); -fx-border-color: rgba(79,70,229,0.2); -fx-border-width: 1; -fx-border-radius: 20;">
                    <children>
                        <Label text="📚 Formations" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #94a3b8; -fx-padding: 0 0 15 0;"/>
                        <Label fx:id="lblTotalFormations" text="0" style="-fx-font-size: 40px; -fx-font-weight: 900; -fx-text-fill: #4f46e5;"/>
                    </children>
                </VBox>

                <!-- Quiz Card -->
                <VBox prefWidth="240" style="-fx-background-color: #1e293b; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 5); -fx-border-color: rgba(34,197,94,0.2); -fx-border-width: 1; -fx-border-radius: 20;">
                    <children>
                        <Label text="✅ Quiz Complétés" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #94a3b8; -fx-padding: 0 0 15 0;"/>
                        <Label fx:id="lblQuizCompletes" text="0" style="-fx-font-size: 40px; -fx-font-weight: 900; -fx-text-fill: #22c55e;"/>
                    </children>
                </VBox>

                <!-- Stages Card -->
                <VBox prefWidth="240" style="-fx-background-color: #1e293b; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 5); -fx-border-color: rgba(234,179,8,0.2); -fx-border-width: 1; -fx-border-radius: 20;">
                    <children>
                        <Label text="💼 Offres Stage" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #94a3b8; -fx-padding: 0 0 15 0;"/>
                        <Label fx:id="lblOffresStage" text="0" style="-fx-font-size: 40px; -fx-font-weight: 900; -fx-text-fill: #eab308;"/>
                    </children>
                </VBox>

                <!-- Certificates Card -->
                <VBox prefWidth="240" style="-fx-background-color: #1e293b; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 5); -fx-border-color: rgba(168,85,247,0.2); -fx-border-width: 1; -fx-border-radius: 20;">
                    <children>
                        <Label text="🏆 Certificats" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #94a3b8; -fx-padding: 0 0 15 0;"/>
                        <Label fx:id="lblCertificats" text="0" style="-fx-font-size: 40px; -fx-font-weight: 900; -fx-text-fill: #a855f7;"/>
                    </children>
                </VBox>
            </children>
        </FlowPane>

        <!-- Main Workspace -->
        <HBox spacing="30" VBox.vgrow="ALWAYS">
            <children>
                <!-- Quick Navigation -->
                <VBox spacing="15" prefWidth="350">
                    <children>
                        <Label text="MON APPRENTISSAGE" style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: 900;"/>
                        <VBox fx:id="menuContainer" spacing="10" style="-fx-background-color: #1e293b; -fx-background-radius: 20; -fx-padding: 20;">
                            <children>
                                <Button fx:id="viewFormationsButton" text="🔍 Catalogue des Formations" maxWidth="Infinity" alignment="CENTER_LEFT"
                                        style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-padding: 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-weight: bold;"/>
                                <Button fx:id="myInscriptionsButton" text="📝 Mes Inscriptions" maxWidth="Infinity" alignment="CENTER_LEFT"
                                        style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-padding: 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-weight: bold;"/>
                                <Button fx:id="takeQuizButton" text="🎯 Passer un Quiz" maxWidth="Infinity" alignment="CENTER_LEFT"
                                        style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-padding: 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(79,70,229,0.3), 10, 0, 0, 3);"/>
                                <Button fx:id="viewOffersButton" text="💼 Offres de Stage" maxWidth="Infinity" alignment="CENTER_LEFT"
                                        style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-padding: 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-weight: bold;"/>
                                <Button fx:id="profileButton" text="⚙️ Mon Profil" maxWidth="Infinity" alignment="CENTER_LEFT"
                                        style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-padding: 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-weight: bold;"/>
                            </children>
                        </VBox>
                        <Label fx:id="statsLabel" text="Dernière mise à jour : ..." style="-fx-text-fill: #475569; -fx-font-size: 11px; -fx-padding: 10 0 0 10;"/>
                    </children>
                </VBox>

                <!-- Activity Feed Placeholder -->
                <VBox spacing="15" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="DERNIÈRE ACTIVITÉ" style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: 900;"/>
                        <VBox alignment="CENTER" spacing="20" VBox.vgrow="ALWAYS" style="-fx-background-color: #1e293b; -fx-background-radius: 20; -fx-border-color: #334155; -fx-border-width: 2; -fx-border-style: dashed; -fx-border-radius: 20;">
                            <children>
                                <Label text="📭" style="-fx-font-size: 48px;"/>
                                <Label text="Aucune activité récente pour le moment" style="-fx-text-fill: #94a3b8; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                                <Label text="Inscrivez-vous à une formation pour commencer !" style="-fx-text-fill: #475569; -fx-font-size: 13px;"/>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>