<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="30" style="-fx-background-color: #0f172a; -fx-padding: 40;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.formini.controllers.dashboard.SocieteDashboardController">
    <children>
        <!-- Header Section -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <children>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label fx:id="titleLabel" text="Espace Recrutement" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                    <Label fx:id="welcomeLabel" text="Gérez vos offres de stage et trouvez vos futurs talents" style="-fx-font-size: 16px; -fx-text-fill: #94a3b8;"/>
                </VBox>
                <VBox alignment="CENTER_RIGHT" spacing="5">
                    <Label fx:id="userInfoLabel" text="Entreprise" style="-fx-text-fill: #a855f7; -fx-font-weight: 900; -fx-font-size: 14px;"/>
                    <Button onAction="#refreshDashboard" text="🔄 Actualiser" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 8 15; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </VBox>
            </children>
        </HBox>

        <!-- Stats Section -->
        <VBox spacing="15" style="-fx-background-color: #1e293b; -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(168,85,247,0.1), 20, 0, 0, 10); -fx-border-color: rgba(168,85,247,0.2); -fx-border-width: 1; -fx-border-radius: 20;">
            <children>
                <Label text="💼 ACTIVITÉ RECRUTEMENT" style="-fx-text-fill: #a855f7; -fx-font-size: 12px; -fx-font-weight: 900; -fx-letter-spacing: 1.5;"/>
                <Label fx:id="statsLabel" text="Analyse des offres en cours..." style="-fx-font-size: 18px; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </children>
        </VBox>

        <!-- Main Actions -->
        <HBox spacing="30" VBox.vgrow="ALWAYS">
            <children>
                <!-- Recruitment Menu -->
                <VBox spacing="15" prefWidth="350">
                    <children>
                        <Label text="GESTION DES OFFRES" style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: 900;"/>
                        <VBox fx:id="menuContainer" spacing="10" style="-fx-background-color: #1e293b; -fx-background-radius: 20; -fx-padding: 20;">
                            <children>
                                <Button fx:id="viewMyOffersButton" text="📋 Mes Offres de Stage" maxWidth="Infinity" alignment="CENTER_LEFT"
                                        style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-padding: 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-weight: bold;"/>
                                <Button fx:id="createOfferButton" text="➕ Publier une Offre" maxWidth="Infinity" alignment="CENTER_LEFT"
                                        style="-fx-background-color: #9333ea; -fx-text-fill: white; -fx-padding: 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(147,51,234,0.3), 10, 0, 0, 3);"/>
                                <Button fx:id="viewApplicationsButton" text="📥 Candidatures Reçues" maxWidth="Infinity" alignment="CENTER_LEFT"
                                        style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-padding: 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-weight: bold;"/>
                                <Button fx:id="profileButton" text="⚙️ Profil Entreprise" maxWidth="Infinity" alignment="CENTER_LEFT"
                                        style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-padding: 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-weight: bold;"/>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- Talent Search Placeholder -->
                <VBox spacing="15" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="TALENTS POTENTIELS" style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: 900;"/>
                        <VBox alignment="CENTER" spacing="20" VBox.vgrow="ALWAYS" style="-fx-background-color: #1e293b; -fx-background-radius: 20; -fx-border-color: #334155; -fx-border-width: 2; -fx-border-style: dashed; -fx-border-radius: 20;">
                            <children>
                                <Label text="🔍" style="-fx-font-size: 48px;"/>
                                <Label text="Découvrez les meilleurs profils" style="-fx-text-fill: #94a3b8; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                                <Label text="Les candidats correspondant à vos critères apparaîtront ici." style="-fx-text-fill: #475569; -fx-font-size: 13px;"/>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>