<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #0f172a; -fx-border-color: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.formini.controllers.dashboard.FormateurDashboardController">
    <VBox spacing="30" style="-fx-background-color: #0f172a; -fx-padding: 40;">
        <children>
            <!-- Header Section -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <children>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label fx:id="titleLabel" text="Tableau de Bord Formateur" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                        <Label fx:id="welcomeLabel" text="Gérez vos formations et vos étudiants" style="-fx-font-size: 16px; -fx-text-fill: #94a3b8;"/>
                    </VBox>
                    <Button onAction="#refreshDashboard" text="🔄 Actualiser" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 20; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </children>
            </HBox>

            <!-- Stats Section -->
            <VBox spacing="15" style="-fx-background-color: #1e293b; -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0, 0, 10); -fx-border-color: rgba(56,189,248,0.1); -fx-border-width: 1; -fx-border-radius: 20;">
                <children>
                    <Label text="📈 MES STATISTIQUES" style="-fx-text-fill: #38bdf8; -fx-font-size: 12px; -fx-font-weight: 900; -fx-letter-spacing: 1.5;"/>
                    <Label fx:id="statsLabel" text="Chargement des données..." style="-fx-font-size: 18px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </children>
            </VBox>

            <!-- Main Workspace -->
            <HBox spacing="30" VBox.vgrow="ALWAYS">
                <children>
                    <!-- Teaching Menu -->
                    <VBox spacing="15" prefWidth="350">
                        <children>
                            <Label text="GESTION PÉDAGOGIQUE" style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: 900;"/>
                            <VBox fx:id="menuContainer" spacing="10" style="-fx-background-color: #1e293b; -fx-background-radius: 20; -fx-padding: 20;">
                                <children>
                                    <Button fx:id="myFormationsButton" text="📚 Mes Formations" maxWidth="Infinity" alignment="CENTER_LEFT"
                                            style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-padding: 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-weight: bold;"/>
                                    <Button fx:id="createFormationButton" text="➕ Créer une Formation" maxWidth="Infinity" alignment="CENTER_LEFT"
                                            style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-padding: 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(2,132,199,0.3), 10, 0, 0, 3);"/>
                                    <Button fx:id="manageLessonsButton" text="📝 Gérer les Leçons" maxWidth="Infinity" alignment="CENTER_LEFT"
                                            style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-padding: 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-weight: bold;"/>
                                    <Button fx:id="manageQuizzesButton" text="🧠 Gérer les Quiz" maxWidth="Infinity" alignment="CENTER_LEFT"
                                            style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-padding: 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-weight: bold;"/>
                                    <Button fx:id="viewStudentsButton" text="👥 Voir les Étudiants" maxWidth="Infinity" alignment="CENTER_LEFT"
                                            style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-padding: 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-weight: bold;"/>
                                    <Button fx:id="myProfileButton" text="⚙️ Mon Profil" maxWidth="Infinity" alignment="CENTER_LEFT"
                                            style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-padding: 15; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-weight: bold;"/>
                                </children>
                            </VBox>
                        </children>
                    </VBox>

                    <!-- Activity Feed -->
                    <VBox spacing="15" HBox.hgrow="ALWAYS">
                        <children>
                            <Label text="ACTIVITÉ RÉCENTE" style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: 900;"/>
                            <VBox alignment="CENTER" spacing="20" VBox.vgrow="ALWAYS" style="-fx-background-color: #1e293b; -fx-background-radius: 20; -fx-border-color: #334155; -fx-border-width: 2; -fx-border-style: dashed; -fx-border-radius: 20;">
                                <children>
                                    <Label text="📅" style="-fx-font-size: 48px;"/>
                                    <Label text="Aucune activité récente" style="-fx-text-fill: #94a3b8; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                                    <Label text="Vos futurs étudiants apparaîtront ici." style="-fx-text-fill: #475569; -fx-font-size: 13px;"/>
                                </children>
                            </VBox>
                        </children>
                    </VBox>
                </children>
            </HBox>
        </children>
    </VBox>
</ScrollPane>
