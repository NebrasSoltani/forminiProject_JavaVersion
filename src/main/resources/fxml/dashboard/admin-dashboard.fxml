<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="30" style="-fx-background-color: #0f172a; -fx-padding: 40;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.formini.controllers.dashboard.AdminDashboardController">
    <children>
        <!-- Header Section -->
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: linear-gradient(to bottom right, #1e293b, #0f172a); -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 20, 0, 0, 10);">
            <children>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label fx:id="titleLabel" text="Administration Système" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                    <Label fx:id="welcomeLabel" text="Gestion globale de la plateforme Formini" style="-fx-font-size: 16px; -fx-text-fill: #38bdf8; -fx-font-weight: bold;"/>
                </VBox>
                <StackPane style="-fx-background-color: rgba(239, 68, 68, 0.1); -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: rgba(239, 68, 68, 0.3); -fx-border-width: 1; -fx-border-radius: 12;">
                    <Label text="🔒 ADMIN" style="-fx-text-fill: #ef4444; -fx-font-weight: 900; -fx-font-size: 14px;"/>
                </StackPane>
            </children>
        </HBox>

        <!-- Stats Section -->
        <VBox spacing="15" style="-fx-background-color: #1e293b; -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 5);">
            <children>
                <Label text="📊 ÉTAT DU SYSTÈME" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-font-weight: 900; -fx-letter-spacing: 1.5;"/>
                <Label fx:id="statsLabel" text="Récupération des statistiques..." style="-fx-font-size: 18px; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </children>
        </VBox>

        <!-- Admin Actions -->
        <VBox spacing="15">
            <children>
                <Label text="GESTION DES UTILISATEURS" style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: 900;"/>
                <FlowPane hgap="20" vgap="20">
                    <children>
                        <Button fx:id="manageUsersButton" text="👥 Tous les Utilisateurs" 
                                style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-pref-width: 250; -fx-pref-height: 60; -fx-background-radius: 12; -fx-cursor: hand;"/>
                        <Button fx:id="manageFormateursButton" text="👨‍🏫 Gérer les Formateurs" 
                                style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-pref-width: 250; -fx-pref-height: 60; -fx-background-radius: 12; -fx-cursor: hand; -fx-border-color: #475569; -fx-border-width: 1; -fx-border-radius: 12;"/>
                        <Button fx:id="manageApprenantsButton" text="🎓 Gérer les Apprenants" 
                                style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-pref-width: 250; -fx-pref-height: 60; -fx-background-radius: 12; -fx-cursor: hand; -fx-border-color: #475569; -fx-border-width: 1; -fx-border-radius: 12;"/>
                        <Button fx:id="manageSocietesButton" text="🏢 Gérer les Sociétés" 
                                style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-pref-width: 250; -fx-pref-height: 60; -fx-background-radius: 12; -fx-cursor: hand; -fx-border-color: #475569; -fx-border-width: 1; -fx-border-radius: 12;"/>
                    </children>
                </FlowPane>
            </children>
        </VBox>

        <VBox spacing="15">
            <children>
                <Label text="GESTION DES CONTENUS" style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: 900;"/>
                <FlowPane hgap="20" vgap="20">
                    <children>
                        <Button fx:id="manageFormationsButton" text="📚 Toutes les Formations" 
                                style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-pref-width: 250; -fx-pref-height: 60; -fx-background-radius: 12; -fx-cursor: hand; -fx-border-color: #475569; -fx-border-width: 1; -fx-border-radius: 12;"/>
                        <Button fx:id="manageCategoriesButton" text="🏷️ Gérer les Catégories" 
                                style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-pref-width: 250; -fx-pref-height: 60; -fx-background-radius: 12; -fx-cursor: hand; -fx-border-color: #475569; -fx-border-width: 1; -fx-border-radius: 12;"/>
                    </children>
                </FlowPane>
            </children>
        </VBox>

        <HBox spacing="15" alignment="CENTER_RIGHT">
            <children>
                <Button onAction="#refreshDashboard" text="Actualiser" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button text="Paramètres Système" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 8; -fx-font-weight: bold;"/>
            </children>
        </HBox>
    </children>
</VBox>
