<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.formini.controllers.blog.BlogFormController"
      spacing="20" styleClass="content-area"
      stylesheets="@/css/style.css"
      style="-fx-background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 20 30 10 30;">
        <Button text="←" onAction="#goBack"
                style="-fx-background-color: white; -fx-text-fill: #667eea; -fx-border-color: transparent; -fx-background-radius: 50; -fx-pref-width: 40; -fx-pref-height: 40; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;"/>
        <VBox spacing="5">
            <Label fx:id="labelFormTitle" text="Rédiger un Article"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Partagez vos connaissances avec la communauté Formini"
                   style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.8);"/>
        </VBox>
    </HBox>

    <!-- Scrollable Content -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background: transparent; -fx-border-color: transparent;">
        <VBox spacing="25" style="-fx-padding: 0 30 20 30;">

            <!-- Card 1: Contenu -->
            <VBox spacing="20"
                  style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 20, 0, 0, 10); -fx-padding: 25;">
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="✍️"
                           style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-background-radius: 50; -fx-pref-width: 35; -fx-pref-height: 35; -fx-alignment: center; -fx-font-size: 18px;"/>
                    <VBox spacing="2">
                        <Label text="Contenu de l'article"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                        <Label text="Titre, résumé et contenu principal du blog"
                               style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
                    </VBox>
                </HBox>

                <GridPane hgap="25" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="250"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="250"/>
                    </columnConstraints>

                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2">
                        <Label text="Titre de l'article *"
                               style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
                        <TextField fx:id="fieldTitre" styleClass="modern-input"
                                   promptText="Ex: Comment maîtriser JavaFX en 30 jours..." prefHeight="45"/>
                        <Label fx:id="errTitre" styleClass="error-label" visible="false"
                               style="-fx-font-size: 12px; -fx-text-fill: #e53e3e;"/>
                    </VBox>

                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                        <Label text="Résumé accrocheur"
                               style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
                        <TextArea fx:id="fieldResume" styleClass="modern-textarea"
                                  prefHeight="80" promptText="Un bref aperçu pour donner envie de lire..." wrapText="true"/>
                    </VBox>

                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                        <Label text="Contenu de l'article *"
                               style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
                        <TextArea fx:id="fieldContenu" styleClass="modern-textarea"
                                  prefHeight="220" promptText="Rédigez votre article ici..." wrapText="true"/>
                        <Label fx:id="errContenu" styleClass="error-label" visible="false"
                               style="-fx-font-size: 12px; -fx-text-fill: #e53e3e;"/>
                    </VBox>
                </GridPane>
            </VBox>

            <!-- Card 2: Paramètres de publication -->
            <VBox spacing="20"
                  style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 20, 0, 0, 10); -fx-padding: 25;">
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="⚙️"
                           style="-fx-background-color: #48bb78; -fx-text-fill: white; -fx-background-radius: 50; -fx-pref-width: 35; -fx-pref-height: 35; -fx-alignment: center; -fx-font-size: 18px;"/>
                    <VBox spacing="2">
                        <Label text="Paramètres de publication"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                        <Label text="Catégorie, événement associé, tags et date"
                               style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
                    </VBox>
                </HBox>

                <GridPane hgap="25" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="250"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="250"/>
                    </columnConstraints>

                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Catégorie *"
                               style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
                        <ComboBox fx:id="fieldCategorie" styleClass="modern-combo"
                                  maxWidth="Infinity" promptText="Choisir une catégorie" prefHeight="45"/>
                        <Label fx:id="errCategorie" styleClass="error-label" visible="false"
                               style="-fx-font-size: 12px; -fx-text-fill: #e53e3e;"/>
                    </VBox>

                    <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Événement associé"
                               style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
                        <ComboBox fx:id="fieldEvenement" styleClass="modern-combo"
                                  maxWidth="Infinity" promptText="Aucun lien" prefHeight="45"/>
                    </VBox>

                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Mots-clés (Tags)"
                               style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
                        <TextField fx:id="fieldTags" styleClass="modern-input"
                                   promptText="java, tuto, formini..." prefHeight="45"/>
                    </VBox>

                    <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Date de publication"
                               style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
                        <DatePicker fx:id="fieldDatePublication" styleClass="modern-date-picker"
                                    maxWidth="Infinity" prefHeight="45"/>
                    </VBox>

                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <CheckBox fx:id="fieldIsPublie" text="Publier immédiatement"
                                  style="-fx-font-size: 14px; -fx-text-fill: #4a5568;"/>
                    </VBox>
                </GridPane>
            </VBox>

            <!-- Card 3: Image & IA -->
            <VBox spacing="20"
                  style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 20, 0, 0, 10); -fx-padding: 25;">
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="🖼️"
                           style="-fx-background-color: #9f7aea; -fx-text-fill: white; -fx-background-radius: 50; -fx-pref-width: 35; -fx-pref-height: 35; -fx-alignment: center; -fx-font-size: 18px;"/>
                    <VBox spacing="2">
                        <Label text="Image &amp; Assistant IA"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                        <Label text="Image de couverture et aide à la rédaction"
                               style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
                    </VBox>
                </HBox>

                <GridPane hgap="25" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="250"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="250"/>
                    </columnConstraints>

                    <!-- Image col -->
                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Image de couverture"
                               style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="fieldImage" styleClass="modern-input"
                                       promptText="Chemin ou URL..." HBox.hgrow="ALWAYS" prefHeight="45" editable="false"/>
                            <Button text="📁" onAction="#browseImage"
                                    style="-fx-background-color: #9f7aea; -fx-text-fill: white; -fx-background-radius: 8; -fx-pref-width: 45; -fx-pref-height: 45; -fx-font-size: 18px; -fx-cursor: hand;"/>
                            <Button text="🤖" onAction="#handleGenerateAIImage"
                                    style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-background-radius: 8; -fx-pref-width: 45; -fx-pref-height: 45; -fx-font-size: 18px; -fx-cursor: hand;"/>
                        </HBox>
                        <StackPane style="-fx-background-color: #f7fafc; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-min-height: 140;">
                            <ImageView fx:id="blogPreview" fitHeight="140" fitWidth="300" preserveRatio="true" pickOnBounds="true"/>
                            <ProgressIndicator fx:id="aiLoading" visible="false" maxHeight="40" maxWidth="40"/>
                        </StackPane>
                    </VBox>

                    <!-- Chatbot Groq col -->
                    <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0"
                          style="-fx-background-color: #f5f3ff; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #ddd6fe; -fx-border-width: 1; -fx-border-radius: 12;">
                        <Label text="✨ Assistant GROQ"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #6d28d9;"/>
                        <ScrollPane fitToWidth="true" prefHeight="140"
                                    style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: transparent;">
                            <VBox fx:id="chatBox" spacing="8" style="-fx-padding: 10;">
                                <Label text="Bonjour ! Je peux vous aider à structurer vos idées."
                                       wrapText="true"
                                       style="-fx-text-fill: #7c3aed; -fx-font-style: italic; -fx-font-size: 12px;"/>
                            </VBox>
                        </ScrollPane>
                        <HBox spacing="8">
                            <TextField fx:id="chatInput" promptText="Une idée pour le titre ?"
                                       HBox.hgrow="ALWAYS" prefHeight="38"
                                       style="-fx-background-radius: 8; -fx-border-color: #ddd6fe; -fx-border-radius: 8; -fx-padding: 8;"/>
                            <Button text="➜" onAction="#handleSendChatMessage"
                                    style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-background-radius: 8; -fx-pref-width: 38; -fx-pref-height: 38; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>
                </GridPane>
            </VBox>

        </VBox>
    </ScrollPane>

    <!-- Action Buttons -->
    <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 0 30 20 30;">
        <Button text="Annuler" onAction="#goBack"
                style="-fx-background-color: white; -fx-text-fill: #667eea; -fx-border-color: #667eea; -fx-border-width: 2; -fx-background-radius: 25; -fx-padding: 12 30; -fx-font-size: 14px; -fx-font-weight: 600; -fx-cursor: hand;"/>
        <Button fx:id="btnSave" text="🚀 Publier l'article" onAction="#saveBlog"
                style="-fx-background-color: white; -fx-text-fill: #667eea; -fx-border-color: #667eea; -fx-border-width: 2; -fx-background-radius: 25; -fx-padding: 12 30; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>

</VBox>